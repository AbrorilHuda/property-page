---
import { Icon } from 'astro-icon/components';

const featuredQuote = {
  quote:
    '“Tata ruang rumahnya terasa efisien dan pencahayaannya terang. Lokasi di area Kangenan memudahkan akses ke pusat kota Pamekasan.”',
  author: 'Hendra Wijaya',
  role: 'Penghuni Bumi Kangenan Cluster',
};

const supportingQuotes = [
  {
    quote:
      '“Lingkungan klaster tenang dan rapi untuk keluarga muda. Komunikasi dengan admin pemasaran juga jelas sejak survei awal.”',
    author: 'Siti Aminah',
    role: 'Penghuni Kawasan Pademawu',
  },
  {
    quote:
      '“Desain fasad modern minimalisnya bersih dan tidak ketinggalan zaman. Akses jalan lingkungannya nyaman untuk aktivitas harian.”',
    author: 'Achmad Syafii',
    role: 'Pemilik Unit Klaster Bugih',
  },
];
---

<section id="testimoni" class="py-20 md:py-28 bg-canvas-muted dark:bg-surface-dark border-y border-[#DCE3D6] dark:border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="reveal max-w-2xl mb-12 space-y-3">
      <h2 class="text-[#111D2E] dark:text-white text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight">
        Pengalaman Penghuni Klaster Bumi Group
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      <!-- Featured Editorial Quote -->
      <figure class="reveal lg:col-span-7 bg-white dark:bg-surface-dark-elevated rounded-2xl p-8 sm:p-10 border border-[#DCE3D6] dark:border-slate-700 shadow-card flex flex-col justify-between space-y-8">
        <div class="space-y-6">
          <div class="w-11 h-11 rounded-xl bg-brand-50 dark:bg-brand-950/70 border border-brand-200 dark:border-brand-800 text-brand-700 dark:text-brand-400 flex items-center justify-center">
            <Icon name="ph:quotes-fill" class="w-5 h-5" aria-hidden="true" />
          </div>
          <blockquote class="text-[#111D2E] dark:text-white text-xl sm:text-2xl font-bold leading-snug tracking-tight">
            {featuredQuote.quote}
          </blockquote>
        </div>

        <figcaption class="pt-5 border-t border-[#DCE3D6] dark:border-slate-700 flex items-center gap-3.5">
          <div class="w-11 h-11 rounded-xl bg-brand-700 text-white flex items-center justify-center font-extrabold text-base shrink-0">
            {featuredQuote.author.charAt(0)}
          </div>
          <div>
            <div class="text-sm font-extrabold text-[#111D2E] dark:text-white">{featuredQuote.author}</div>
            <div class="text-xs font-semibold text-slate-600 dark:text-slate-400">{featuredQuote.role}</div>
          </div>
        </figcaption>
      </figure>

      <!-- 2 Stacked Supporting Quotes -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        {supportingQuotes.map((item, idx) => (
          <figure class={`reveal reveal-delay-${idx + 1} flex-1 bg-white dark:bg-surface-dark-elevated rounded-2xl p-6 sm:p-7 border border-[#DCE3D6] dark:border-slate-700 shadow-card flex flex-col justify-between space-y-5`}>
            <blockquote class="text-slate-700 dark:text-slate-200 text-sm sm:text-base font-semibold leading-relaxed">
              {item.quote}
            </blockquote>
            <figcaption class="pt-4 border-t border-[#DCE3D6] dark:border-slate-700">
              <div class="text-sm font-extrabold text-[#111D2E] dark:text-white">{item.author}</div>
              <div class="text-xs font-semibold text-slate-600 dark:text-slate-400">{item.role}</div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>
