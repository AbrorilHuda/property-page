---
const testimonials = [
  {
    name: 'Budi Santoso',
    unit: 'Tipe 45',
    rating: 5,
    quote: 'Proses pembelian mudah, tim ramah, dan rumahnya sesuai ekspektasi. Lingkungannya sangat asri dan nyaman untuk anak-anak. Terima kasih Bumi Group!',
  },
  {
    name: 'Rina Wati',
    unit: 'Tipe 36',
    rating: 5,
    quote: 'Sebagai pasangan muda, kami sangat terbantu dengan cicilan yang ringan. Rumahnya compact tapi fungsional banget. Sudah 6 bulan tinggal dan sangat puas!',
  },
  {
    name: 'Ahmad Fauzi',
    unit: 'Tipe 60',
    rating: 5,
    quote: 'Tipe 60 ini luas dan lega untuk keluarga kami. Fasilitas keamanan 24 jam bikin tenang. Lokasinya juga strategis, dekat kemana-mana.',
  },
];
---

<section id="testimonials" class="py-20 md:py-28 bg-white border-t border-slate-200">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6">
    <div class="reveal text-center max-w-3xl mx-auto mb-16 space-y-3">
      <h2 class="text-slate-900 text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight">
        Kata Mereka yang Sudah Percaya Bumi Group
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {testimonials.map((t, idx) => (
        <div class={`reveal reveal-delay-${idx + 1} hover-lift bg-slate-50 border border-slate-200 rounded-3xl p-6 md:p-8 flex flex-col justify-between shadow-card hover:border-emerald-400 transition-all`}>
          <div>
            <div class="flex gap-1 mb-4">
              {Array.from({ length: t.rating }).map(() => (
                <svg class="w-5 h-5 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>

            <blockquote class="text-slate-800 text-sm sm:text-base font-semibold leading-relaxed mb-6">
              "{t.quote}"
            </blockquote>
          </div>

          <div class="flex items-center gap-3 border-t border-slate-200 pt-4">
            <div class="w-11 h-11 rounded-full bg-emerald-700 text-white flex items-center justify-center font-extrabold text-base shadow-sm">
              {t.name.charAt(0)}
            </div>
            <div>
              <div class="text-slate-900 text-sm font-extrabold">{t.name}</div>
              <div class="text-slate-600 text-xs font-semibold">Penghuni {t.unit}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
