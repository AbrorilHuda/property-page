---
// ContactForm will be a client-side component for interactivity
---

<section id="contact-form" class="py-20 md:py-28 bg-slate-50 border-t border-slate-200">
  <div class="max-w-[720px] mx-auto px-4 sm:px-6">
    <div class="reveal text-center mb-10 space-y-3">
      <h2 class="text-slate-900 text-3xl sm:text-4xl font-extrabold">
        Daftar Survey & Konsultasi Gratis
      </h2>
      <p class="text-slate-700 text-base sm:text-lg font-medium">
        Isi formulir di bawah ini, tim marketing kami akan segera menghubungi Anda.
      </p>
    </div>

    <form id="contact-form-element" class="reveal reveal-delay-1 bg-white rounded-3xl p-6 sm:p-10 shadow-card border border-slate-200 text-slate-900">
      <div class="space-y-6">
        <!-- Nama Lengkap -->
        <div>
          <label for="namaLengkap" class="block text-slate-900 text-sm font-bold mb-2">
            Nama Lengkap <span class="text-red-600">*</span>
          </label>
          <input
            type="text"
            id="namaLengkap"
            name="namaLengkap"
            required
            class="w-full px-4 py-3.5 border-2 border-slate-300 rounded-xl focus:outline-none focus:border-emerald-700 transition-colors text-slate-900 font-semibold placeholder:text-slate-400"
            placeholder="Masukkan nama lengkap Anda"
          />
          <p id="error-namaLengkap" class="text-red-600 text-sm font-bold mt-1 hidden" role="alert"></p>
        </div>

        <!-- Email -->
        <div>
          <label for="email" class="block text-slate-900 text-sm font-bold mb-2">
            Email <span class="text-red-600">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-3.5 border-2 border-slate-300 rounded-xl focus:outline-none focus:border-emerald-700 transition-colors text-slate-900 font-semibold placeholder:text-slate-400"
            placeholder="nama@email.com"
          />
          <p id="error-email" class="text-red-600 text-sm font-bold mt-1 hidden" role="alert"></p>
        </div>

        <!-- Nomor WhatsApp -->
        <div>
          <label for="nomorWhatsApp" class="block text-slate-900 text-sm font-bold mb-2">
            Nomor WhatsApp <span class="text-red-600">*</span>
          </label>
          <input
            type="tel"
            id="nomorWhatsApp"
            name="nomorWhatsApp"
            required
            class="w-full px-4 py-3.5 border-2 border-slate-300 rounded-xl focus:outline-none focus:border-emerald-700 transition-colors text-slate-900 font-semibold placeholder:text-slate-400"
            placeholder="Contoh: 08123456789"
          />
          <p id="error-nomorWhatsApp" class="text-red-600 text-sm font-bold mt-1 hidden" role="alert"></p>
        </div>

        <!-- Pesan Singkat -->
        <div>
          <label for="pesanSingkat" class="block text-slate-900 text-sm font-bold mb-2">
            Pesan Singkat (Opsional)
          </label>
          <textarea
            id="pesanSingkat"
            name="pesanSingkat"
            rows="4"
            class="w-full px-4 py-3.5 border-2 border-slate-300 rounded-xl focus:outline-none focus:border-emerald-700 transition-colors text-slate-900 font-semibold placeholder:text-slate-400 resize-none"
            placeholder="Tulis pertanyaan atau jadwal survey yang diinginkan..."
          ></textarea>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          class="w-full bg-emerald-700 hover:bg-emerald-800 text-white px-6 py-4 rounded-xl font-extrabold shadow-md hover:scale-[1.01] active:scale-95 transition-all duration-200 min-h-[50px] disabled:opacity-50 disabled:cursor-not-allowed"
          id="submit-btn"
        >
          Kirim & Hubungi via WhatsApp
        </button>
      </div>

      <!-- Success Message -->
      <div id="success-message" class="hidden mt-6 p-4 bg-emerald-50 border border-emerald-300 rounded-xl animate-in fade-in duration-300">
        <div class="flex items-start gap-3">
          <span class="text-emerald-700 font-bold text-xl">✓</span>
          <div>
            <p class="text-emerald-900 font-extrabold">Formulir Terkirim!</p>
            <p class="text-emerald-800 text-sm mt-1 font-semibold">Anda sedang dialihkan ke WhatsApp marketing kami...</p>
          </div>
        </div>
      </div>

      <!-- Error Message -->
      <div id="error-message" class="hidden mt-6 p-4 bg-red-50 border border-red-300 rounded-xl animate-in fade-in duration-300">
        <div class="flex items-start gap-3">
          <span class="text-red-600 font-bold text-xl">✕</span>
          <div>
            <p class="text-red-900 font-extrabold">Terjadi Kesalahan</p>
            <p class="text-red-800 text-sm mt-1 font-semibold">Silakan periksa kembali data Anda atau hubungi WhatsApp langsung.</p>
          </div>
        </div>
      </div>
    </form>
  </div>
</section>

<script>
  import { validateName, validateEmail, validateWhatsApp } from '../utils/validation';
  import { whatsappLink } from '../utils/config';

  const form = document.getElementById('contact-form-element') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successMessage = document.getElementById('success-message');
  const errorMessage = document.getElementById('error-message');

  const namaLengkapInput = document.getElementById('namaLengkap') as HTMLInputElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const nomorWhatsAppInput = document.getElementById('nomorWhatsApp') as HTMLInputElement;
  const pesanSingkatInput = document.getElementById('pesanSingkat') as HTMLTextAreaElement;

  const errorNama = document.getElementById('error-namaLengkap');
  const errorEmail = document.getElementById('error-email');
  const errorWhatsApp = document.getElementById('error-nomorWhatsApp');

  function showError(element: HTMLElement | null, message: string) {
    if (element) {
      element.textContent = message;
      element.classList.remove('hidden');
    }
  }

  function hideError(element: HTMLElement | null) {
    if (element) {
      element.textContent = '';
      element.classList.add('hidden');
    }
  }

  function validateForm() {
    let isValid = true;

    hideError(errorNama);
    hideError(errorEmail);
    hideError(errorWhatsApp);

    const nameError = validateName(namaLengkapInput.value);
    if (nameError) {
      showError(errorNama, nameError);
      namaLengkapInput.classList.add('border-red-500');
      isValid = false;
    } else {
      namaLengkapInput.classList.remove('border-red-500');
    }

    const emailError = validateEmail(emailInput.value);
    if (emailError) {
      showError(errorEmail, emailError);
      emailInput.classList.add('border-red-500');
      isValid = false;
    } else {
      emailInput.classList.remove('border-red-500');
    }

    const whatsappError = validateWhatsApp(nomorWhatsAppInput.value);
    if (whatsappError) {
      showError(errorWhatsApp, whatsappError);
      nomorWhatsAppInput.classList.add('border-red-500');
      isValid = false;
    } else {
      nomorWhatsAppInput.classList.remove('border-red-500');
    }

    return isValid;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    successMessage?.classList.add('hidden');
    errorMessage?.classList.add('hidden');

    if (!validateForm()) {
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Mengirim...';

    const formData = {
      namaLengkap: namaLengkapInput.value.trim(),
      email: emailInput.value.trim(),
      nomorWhatsApp: nomorWhatsAppInput.value.trim(),
      pesanSingkat: pesanSingkatInput.value.trim(),
    };

    try {
      await new Promise(resolve => setTimeout(resolve, 800));

      const message = `Halo Bumi Group, saya ${formData.namaLengkap} ingin survey lokasi perumahan.\n\nEmail: ${formData.email}\nNo. WA: ${formData.nomorWhatsApp}\nPesan/Pertanyaan: ${formData.pesanSingkat || 'Mohon jadwalkan survey lokasi.'}`;
      
      successMessage?.classList.remove('hidden');
      form.reset();

      setTimeout(() => {
        window.open(whatsappLink(message), '_blank');
      }, 1500);

    } catch (error) {
      console.error('Form submission error:', error);
      errorMessage?.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Kirim & Hubungi via WhatsApp';
    }
  });

  namaLengkapInput?.addEventListener('blur', () => {
    const error = validateName(namaLengkapInput.value);
    if (error) {
      showError(errorNama, error);
      namaLengkapInput.classList.add('border-red-500');
    } else {
      hideError(errorNama);
      namaLengkapInput.classList.remove('border-red-500');
    }
  });

  emailInput?.addEventListener('blur', () => {
    const error = validateEmail(emailInput.value);
    if (error) {
      showError(errorEmail, error);
      emailInput.classList.add('border-red-500');
    } else {
      hideError(errorEmail);
      emailInput.classList.remove('border-red-500');
    }
  });

  nomorWhatsAppInput?.addEventListener('blur', () => {
    const error = validateWhatsApp(nomorWhatsAppInput.value);
    if (error) {
      showError(errorWhatsApp, error);
      nomorWhatsAppInput.classList.add('border-red-500');
    } else {
      hideError(errorWhatsApp);
      nomorWhatsAppInput.classList.remove('border-red-500');
    }
  });
</script>
