---
// ContactForm will be a client-side component for interactivity
---

<section id="contact-form" class="py-16 md:py-20 bg-white">
  <div class="max-w-[720px] mx-auto px-4 sm:px-6">
    <div class="text-center mb-10">
      <h2 class="text-bumi-navy-dark text-2xl sm:text-3xl md:text-4xl font-bold mb-4">
        Daftar Survey Lokasi
      </h2>
      <p class="text-bumi-navy-light text-base sm:text-lg">
        Isi formulir di bawah ini, tim kami akan menghubungi Anda secepatnya.
      </p>
    </div>

    <form id="contact-form-element" class="bg-bumi-off-white rounded-2xl p-6 md:p-10">
      <div class="space-y-5">
        <!-- Nama Lengkap -->
        <div>
          <label for="namaLengkap" class="block text-bumi-navy-dark text-sm font-semibold mb-2">
            Nama Lengkap <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="namaLengkap"
            name="namaLengkap"
            required
            class="w-full px-4 py-3 border-2 border-bumi-sage rounded-lg focus:outline-none focus:border-bumi-green-dark transition-colors text-bumi-navy-dark"
            placeholder="Masukkan nama lengkap Anda"
          />
          <p id="error-namaLengkap" class="text-red-500 text-sm mt-1 hidden" role="alert"></p>
        </div>

        <!-- Email -->
        <div>
          <label for="email" class="block text-bumi-navy-dark text-sm font-semibold mb-2">
            Email <span class="text-red-500">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-3 border-2 border-bumi-sage rounded-lg focus:outline-none focus:border-bumi-green-dark transition-colors text-bumi-navy-dark"
            placeholder="nama@email.com"
          />
          <p id="error-email" class="text-red-500 text-sm mt-1 hidden" role="alert"></p>
        </div>

        <!-- Nomor WhatsApp -->
        <div>
          <label for="nomorWhatsApp" class="block text-bumi-navy-dark text-sm font-semibold mb-2">
            Nomor WhatsApp <span class="text-red-500">*</span>
          </label>
          <input
            type="tel"
            id="nomorWhatsApp"
            name="nomorWhatsApp"
            required
            class="w-full px-4 py-3 border-2 border-bumi-sage rounded-lg focus:outline-none focus:border-bumi-green-dark transition-colors text-bumi-navy-dark"
            placeholder="+62812345678 atau 08123456789"
          />
          <p id="error-nomorWhatsApp" class="text-red-500 text-sm mt-1 hidden" role="alert"></p>
        </div>

        <!-- Pesan Singkat -->
        <div>
          <label for="pesanSingkat" class="block text-bumi-navy-dark text-sm font-semibold mb-2">
            Pesan Singkat (Opsional)
          </label>
          <textarea
            id="pesanSingkat"
            name="pesanSingkat"
            rows="4"
            class="w-full px-4 py-3 border-2 border-bumi-sage rounded-lg focus:outline-none focus:border-bumi-green-dark transition-colors text-bumi-navy-dark resize-none"
            placeholder="Tulis pertanyaan atau informasi tambahan..."
          ></textarea>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          class="w-full bg-bumi-green-dark text-white px-6 py-4 rounded-xl font-semibold hover:bg-bumi-green-medium transition-colors duration-200 min-h-[48px] disabled:opacity-50 disabled:cursor-not-allowed"
          id="submit-btn"
        >
          Kirim Formulir
        </button>
      </div>

      <!-- Success Message -->
      <div id="success-message" class="hidden mt-6 p-4 bg-green-50 border border-green-200 rounded-lg">
        <div class="flex items-start gap-3">
          <svg class="w-6 h-6 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div>
            <p class="text-green-800 font-semibold">Terima kasih!</p>
            <p class="text-green-700 text-sm mt-1">Kami akan segera menghubungi Anda.</p>
          </div>
        </div>
      </div>

      <!-- Error Message -->
      <div id="error-message" class="hidden mt-6 p-4 bg-red-50 border border-red-200 rounded-lg">
        <div class="flex items-start gap-3">
          <svg class="w-6 h-6 text-red-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div>
            <p class="text-red-800 font-semibold">Terjadi kesalahan</p>
            <p class="text-red-700 text-sm mt-1">Silakan coba lagi atau hubungi kami via WhatsApp.</p>
          </div>
        </div>
      </div>
    </form>
  </div>
</section>

<script>
  import { validateName, validateEmail, validateWhatsApp } from '../utils/validation';
  import { whatsappLink } from '../utils/config';

  const form = document.getElementById('contact-form-element') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successMessage = document.getElementById('success-message');
  const errorMessage = document.getElementById('error-message');

  // Field elements
  const namaLengkapInput = document.getElementById('namaLengkap') as HTMLInputElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const nomorWhatsAppInput = document.getElementById('nomorWhatsApp') as HTMLInputElement;
  const pesanSingkatInput = document.getElementById('pesanSingkat') as HTMLTextAreaElement;

  // Error message elements
  const errorNama = document.getElementById('error-namaLengkap');
  const errorEmail = document.getElementById('error-email');
  const errorWhatsApp = document.getElementById('error-nomorWhatsApp');

  function showError(element: HTMLElement | null, message: string) {
    if (element) {
      element.textContent = message;
      element.classList.remove('hidden');
    }
  }

  function hideError(element: HTMLElement | null) {
    if (element) {
      element.textContent = '';
      element.classList.add('hidden');
    }
  }

  function validateForm() {
    let isValid = true;

    // Clear previous errors
    hideError(errorNama);
    hideError(errorEmail);
    hideError(errorWhatsApp);

    // Validate Nama Lengkap
    const nameError = validateName(namaLengkapInput.value);
    if (nameError) {
      showError(errorNama, nameError);
      namaLengkapInput.classList.add('border-red-500');
      isValid = false;
    } else {
      namaLengkapInput.classList.remove('border-red-500');
    }

    // Validate Email
    const emailError = validateEmail(emailInput.value);
    if (emailError) {
      showError(errorEmail, emailError);
      emailInput.classList.add('border-red-500');
      isValid = false;
    } else {
      emailInput.classList.remove('border-red-500');
    }

    // Validate WhatsApp
    const whatsappError = validateWhatsApp(nomorWhatsAppInput.value);
    if (whatsappError) {
      showError(errorWhatsApp, whatsappError);
      nomorWhatsAppInput.classList.add('border-red-500');
      isValid = false;
    } else {
      nomorWhatsAppInput.classList.remove('border-red-500');
    }

    return isValid;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Hide previous messages
    successMessage?.classList.add('hidden');
    errorMessage?.classList.add('hidden');

    // Validate form
    if (!validateForm()) {
      return;
    }

    // Disable submit button
    submitBtn.disabled = true;
    submitBtn.textContent = 'Mengirim...';

    // Prepare form data
    const formData = {
      namaLengkap: namaLengkapInput.value.trim(),
      email: emailInput.value.trim(),
      nomorWhatsApp: nomorWhatsAppInput.value.trim(),
      pesanSingkat: pesanSingkatInput.value.trim(),
    };

    try {
      // Simulate API call (replace with actual endpoint later)
      await new Promise(resolve => setTimeout(resolve, 1000));

      // Option 1: Show success and redirect to WhatsApp
      const message = `Halo, saya ${formData.namaLengkap}. Saya tertarik dengan perumahan Bumi Group.\n\nEmail: ${formData.email}\nNo. WhatsApp: ${formData.nomorWhatsApp}\n\nPesan: ${formData.pesanSingkat || 'Mohon info lebih lanjut'}`;
      
      successMessage?.classList.remove('hidden');
      form.reset();

      // Redirect to WhatsApp after 2 seconds
      setTimeout(() => {
        window.open(whatsappLink(message), '_blank');
      }, 2000);

    } catch (error) {
      console.error('Form submission error:', error);
      errorMessage?.classList.remove('hidden');
    } finally {
      // Re-enable submit button
      submitBtn.disabled = false;
      submitBtn.textContent = 'Kirim Formulir';
    }
  });

  // Real-time validation on blur
  namaLengkapInput?.addEventListener('blur', () => {
    const error = validateName(namaLengkapInput.value);
    if (error) {
      showError(errorNama, error);
      namaLengkapInput.classList.add('border-red-500');
    } else {
      hideError(errorNama);
      namaLengkapInput.classList.remove('border-red-500');
    }
  });

  emailInput?.addEventListener('blur', () => {
    const error = validateEmail(emailInput.value);
    if (error) {
      showError(errorEmail, error);
      emailInput.classList.add('border-red-500');
    } else {
      hideError(errorEmail);
      emailInput.classList.remove('border-red-500');
    }
  });

  nomorWhatsAppInput?.addEventListener('blur', () => {
    const error = validateWhatsApp(nomorWhatsAppInput.value);
    if (error) {
      showError(errorWhatsApp, error);
      nomorWhatsAppInput.classList.add('border-red-500');
    } else {
      hideError(errorWhatsApp);
      nomorWhatsAppInput.classList.remove('border-red-500');
    }
  });
</script>
