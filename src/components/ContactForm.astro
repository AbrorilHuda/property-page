---
// ContactForm: validasi klien + penyerahan ke WhatsApp
---

<section id="contact-form" class="py-20 md:py-28 bg-slate-50 border-t border-slate-200">
  <div class="max-w-[720px] mx-auto px-4 sm:px-6">
    <div class="reveal text-center mb-10 space-y-3">
      <h2 class="text-slate-900 text-3xl sm:text-4xl font-extrabold">
        Daftar Survey & Konsultasi Gratis
      </h2>
      <p class="text-slate-700 text-base sm:text-lg font-medium">
        Isi formulir di bawah ini, tim marketing kami akan segera menghubungi Anda.
      </p>
    </div>

    <form id="contact-form-element" class="reveal reveal-delay-1 bg-white rounded-3xl p-6 sm:p-10 shadow-card border border-slate-200 text-slate-900" novalidate>
      <div class="space-y-6">
        <!-- Nama Lengkap -->
        <div>
          <label for="namaLengkap" class="block text-slate-900 text-sm font-bold mb-2">
            Nama Lengkap <span class="text-red-600" aria-hidden="true">*</span>
          </label>
          <input
            type="text"
            id="namaLengkap"
            name="namaLengkap"
            required
            autocomplete="name"
            aria-describedby="error-namaLengkap"
            class="w-full px-4 py-3.5 border-2 border-slate-300 rounded-xl focus:outline-none focus:border-brand-700 transition-colors text-slate-900 font-semibold placeholder:text-slate-500"
            placeholder="Masukkan nama lengkap Anda"
          />
          <p id="error-namaLengkap" class="text-red-600 text-sm font-bold mt-1 hidden" role="alert"></p>
        </div>

        <!-- Email -->
        <div>
          <label for="email" class="block text-slate-900 text-sm font-bold mb-2">
            Email <span class="text-red-600" aria-hidden="true">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            aria-describedby="error-email"
            class="w-full px-4 py-3.5 border-2 border-slate-300 rounded-xl focus:outline-none focus:border-brand-700 transition-colors text-slate-900 font-semibold placeholder:text-slate-500"
            placeholder="nama@email.com"
          />
          <p id="error-email" class="text-red-600 text-sm font-bold mt-1 hidden" role="alert"></p>
        </div>

        <!-- Nomor WhatsApp -->
        <div>
          <label for="nomorWhatsApp" class="block text-slate-900 text-sm font-bold mb-2">
            Nomor WhatsApp <span class="text-red-600" aria-hidden="true">*</span>
          </label>
          <input
            type="tel"
            id="nomorWhatsApp"
            name="nomorWhatsApp"
            required
            autocomplete="tel"
            inputmode="tel"
            aria-describedby="error-nomorWhatsApp"
            class="w-full px-4 py-3.5 border-2 border-slate-300 rounded-xl focus:outline-none focus:border-brand-700 transition-colors text-slate-900 font-semibold placeholder:text-slate-500"
            placeholder="Contoh: 08123456789"
          />
          <p id="error-nomorWhatsApp" class="text-red-600 text-sm font-bold mt-1 hidden" role="alert"></p>
        </div>

        <!-- Pesan Singkat -->
        <div>
          <label for="pesanSingkat" class="block text-slate-900 text-sm font-bold mb-2">
            Pesan Singkat (Opsional)
          </label>
          <textarea
            id="pesanSingkat"
            name="pesanSingkat"
            rows="4"
            class="w-full px-4 py-3.5 border-2 border-slate-300 rounded-xl focus:outline-none focus:border-brand-700 transition-colors text-slate-900 font-semibold placeholder:text-slate-500 resize-none"
            placeholder="Tulis pertanyaan atau jadwal survey yang diinginkan..."
          ></textarea>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          class="w-full bg-brand-700 hover:bg-brand-800 text-white px-6 py-4 rounded-xl font-extrabold shadow-md active:scale-[0.99] transition-all duration-200 min-h-[50px] disabled:opacity-50 disabled:cursor-not-allowed"
          id="submit-btn"
        >
          Kirim & Hubungi via WhatsApp
        </button>
      </div>

      <!-- Success Message dengan tautan manual (tahan terhadap popup blocker) -->
      <div id="success-message" class="hidden mt-6 p-4 bg-brand-50 border border-brand-300 rounded-xl">
        <div class="flex items-start gap-3">
          <span class="text-brand-700 font-bold text-xl" aria-hidden="true">✓</span>
          <div>
            <p class="text-brand-900 font-extrabold">Data Anda Siap Dikirim!</p>
            <p class="text-brand-800 text-sm mt-1 font-semibold">
              WhatsApp akan terbuka otomatis. Jika tidak terbuka, tekan tombol di bawah ini.
            </p>
            <a
              id="success-wa-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-flex items-center justify-center gap-2 bg-brand-700 hover:bg-brand-800 text-white text-sm font-bold px-5 py-3 rounded-xl min-h-11 transition-colors"
            >
              Buka WhatsApp Sekarang
            </a>
          </div>
        </div>
      </div>
    </form>
  </div>
</section>

<script>
  import { validateName, validateEmail, validateWhatsApp } from '../utils/validation';
  import { whatsappLink } from '../utils/config';

  const form = document.getElementById('contact-form-element') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successMessage = document.getElementById('success-message');
  const successWaLink = document.getElementById('success-wa-link') as HTMLAnchorElement;

  const namaLengkapInput = document.getElementById('namaLengkap') as HTMLInputElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const nomorWhatsAppInput = document.getElementById('nomorWhatsApp') as HTMLInputElement;
  const pesanSingkatInput = document.getElementById('pesanSingkat') as HTMLTextAreaElement;

  const errorNama = document.getElementById('error-namaLengkap');
  const errorEmail = document.getElementById('error-email');
  const errorWhatsApp = document.getElementById('error-nomorWhatsApp');

  function showError(element: HTMLElement | null, message: string) {
    if (element) {
      element.textContent = message;
      element.classList.remove('hidden');
    }
  }

  function hideError(element: HTMLElement | null) {
    if (element) {
      element.textContent = '';
      element.classList.add('hidden');
    }
  }

  function setFieldState(
    input: HTMLInputElement,
    errorEl: HTMLElement | null,
    message: string | null
  ) {
    if (message) {
      showError(errorEl, message);
      input.classList.add('border-red-500');
      input.setAttribute('aria-invalid', 'true');
    } else {
      hideError(errorEl);
      input.classList.remove('border-red-500');
      input.removeAttribute('aria-invalid');
    }
  }

  function validateForm() {
    hideError(errorNama);
    hideError(errorEmail);
    hideError(errorWhatsApp);

    let firstInvalid: HTMLInputElement | null = null;

    const nameError = validateName(namaLengkapInput.value);
    setFieldState(namaLengkapInput, errorNama, nameError);
    if (nameError) firstInvalid ??= namaLengkapInput;

    const emailError = validateEmail(emailInput.value);
    setFieldState(emailInput, errorEmail, emailError);
    if (emailError) firstInvalid ??= emailInput;

    const whatsappError = validateWhatsApp(nomorWhatsAppInput.value);
    setFieldState(nomorWhatsAppInput, errorWhatsApp, whatsappError);
    if (whatsappError) firstInvalid ??= nomorWhatsAppInput;

    firstInvalid?.focus();
    return !firstInvalid;
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    successMessage?.classList.add('hidden');

    if (!validateForm()) {
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Membuka WhatsApp...';

    const namaLengkap = namaLengkapInput.value.trim();
    const email = emailInput.value.trim();
    const nomorWhatsApp = nomorWhatsAppInput.value.trim();
    const pesanSingkat = pesanSingkatInput.value.trim();

    const message = `Halo Bumi Group, saya ${namaLengkap} ingin survey lokasi perumahan.\n\nEmail: ${email}\nNo. WA: ${nomorWhatsApp}\nPesan/Pertanyaan: ${pesanSingkat || 'Mohon jadwalkan survey lokasi.'}`;
    const waUrl = whatsappLink(message);

    // Tautan manual selalu tersedia — kebal popup blocker.
    if (successWaLink) successWaLink.href = waUrl;
    successMessage?.classList.remove('hidden');

    window.open(waUrl, '_blank', 'noopener');

    form.reset();
    [namaLengkapInput, emailInput, nomorWhatsAppInput].forEach(i => i.classList.remove('border-red-500'));

    submitBtn.disabled = false;
    submitBtn.textContent = 'Kirim & Hubungi via WhatsApp';
  });

  namaLengkapInput?.addEventListener('blur', () => {
    setFieldState(namaLengkapInput, errorNama, validateName(namaLengkapInput.value));
  });

  emailInput?.addEventListener('blur', () => {
    setFieldState(emailInput, errorEmail, validateEmail(emailInput.value));
  });

  nomorWhatsAppInput?.addEventListener('blur', () => {
    setFieldState(nomorWhatsAppInput, errorWhatsApp, validateWhatsApp(nomorWhatsAppInput.value));
  });
</script>
