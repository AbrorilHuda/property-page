---
import { Icon } from 'astro-icon/components';
import { companyProfile } from '../data/bumiGroup';
import { whatsappLink } from '../utils/config';

const quickLinks = [
  { href: '/#hero', label: 'Beranda' },
  { href: '/#proyek', label: 'Proyek Pamekasan' },
  { href: '/#konsep', label: 'Konsep Hunian' },
  { href: '/#tipe-unit', label: 'Tipe Unit' },
  { href: '/#galeri', label: 'Galeri Visual' },
  { href: '/#simulasi-kpr', label: 'Simulasi KPR' },
  { href: '/report', label: 'Lapor Keluhan' },
];
---

<footer class="bg-canvas-dark text-white py-14 md:py-18 no-print border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 pb-12 border-b border-slate-800">

      <!-- Brand & Legal Entity -->
      <div class="lg:col-span-5 space-y-5">
        <div class="bg-white px-3 py-2 rounded-xl inline-block">
          <img
            src="/bumigrouplogo.png"
            alt="Logo Bumi Group"
            class="h-9 w-auto object-contain"
          />
        </div>
        <p class="text-slate-300 text-sm leading-relaxed font-medium max-w-md">
          <strong class="text-white">{companyProfile.legalName} ({companyProfile.brandName})</strong> adalah pengembang properti dan kontraktor perumahan lokal di Kabupaten Pamekasan, Madura yang menghadirkan kawasan klaster modern minimalis.
        </p>
      </div>

      <!-- Quick Links -->
      <div class="lg:col-span-3 space-y-4">
        <h3 class="text-sm font-extrabold uppercase tracking-wider text-slate-200">Navigasi</h3>
        <ul class="space-y-2.5 text-sm font-semibold">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-slate-300 hover:text-brand-400 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Official Contact -->
      <div class="lg:col-span-4 space-y-4">
        <h3 class="text-sm font-extrabold uppercase tracking-wider text-slate-200">Kantor Pusat Pemasaran</h3>
        <ul class="space-y-3 text-sm font-medium text-slate-300">
          <li class="flex items-start gap-2.5">
            <Icon name="ph:map-pin-bold" class="w-5 h-5 shrink-0 mt-0.5 text-brand-400" aria-hidden="true" />
            <span>{companyProfile.headOfficeAddress}</span>
          </li>
          <li class="flex items-center gap-2.5">
            <Icon name="ph:whatsapp-logo-fill" class="w-5 h-5 shrink-0 text-brand-400" aria-hidden="true" />
            <a
              href={whatsappLink('Halo Admin Kantor Pusat Bumi Group Pamekasan, saya ingin informasi perumahan.', companyProfile.mainAdminPhone)}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
            >
              {companyProfile.mainAdminPhone} (Kantor Pusat &amp; Tlanakan)
            </a>
          </li>
          <li class="flex items-center gap-2.5">
            <Icon name="ph:envelope-simple-bold" class="w-5 h-5 shrink-0 text-brand-400" aria-hidden="true" />
            <a href={`mailto:${companyProfile.email}`} class="hover:text-white transition-colors">
              {companyProfile.email}
            </a>
          </li>
          <li class="flex items-center gap-2.5">
            <Icon name="ph:instagram-logo-bold" class="w-5 h-5 shrink-0 text-brand-400" aria-hidden="true" />
            <a href={companyProfile.instagramUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
              {companyProfile.instagramHandle}
            </a>
          </li>
        </ul>
      </div>

    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs sm:text-sm font-semibold text-slate-400">
      <p>© {new Date().getFullYear()} {companyProfile.legalName} ({companyProfile.brandName}). Hak cipta dilindungi.</p>
      <p>{companyProfile.region}</p>
    </div>
  </div>
</footer>
