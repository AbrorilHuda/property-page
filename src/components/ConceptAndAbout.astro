---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import livingRoomImg from '../assets/images/living_room.png';

const architecturalPillars = [
  {
    icon: 'ph:house-line-bold',
    title: 'Gaya Modern & Minimalis',
    desc: 'Fasad rumah masa kini yang bersih, simpel, dan fungsional untuk keluarga muda maupun hunian jangka panjang.',
  },
  {
    icon: 'ph:grid-four-bold',
    title: 'Konsep Klaster & Tata Ruang Efisien',
    desc: 'Kawasan dirancang tertata dengan akses jalan lingkungan yang nyaman serta pemanfaatan ruang dalam rumah yang optimal.',
  },
  {
    icon: 'ph:buildings-bold',
    title: 'Pilihan Tipe Komersial & Residensial',
    desc: 'Tersedia variasi luas bangunan, termasuk pengembangan rumah Tipe 50 di Tlanakan serta unit klaster di Kangenan, Bugih, dan Pademawu.',
  },
];
---

<section id="konsep" class="py-20 md:py-28 bg-canvas-light dark:bg-canvas-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">

      <!-- Left Architectural Interior Photo -->
      <div class="lg:col-span-5 reveal">
        <figure class="space-y-3">
          <div class="rounded-2xl overflow-hidden border border-[#DCE3D6] dark:border-slate-800 shadow-card bg-white dark:bg-surface-dark">
            <Image
              src={livingRoomImg}
              alt="Penataan ruang keluarga modern minimalis yang efisien dan terang alami"
              widths={[480, 768, 1080]}
              sizes="(min-width: 1024px) 42vw, 100vw"
              loading="lazy"
              class="w-full aspect-[4/5] object-cover"
            />
          </div>
          <figcaption class="text-xs sm:text-sm font-semibold text-slate-600 dark:text-slate-400">
            Pemanfaatan tata ruang dalam yang efisien dan pencahayaan alami
          </figcaption>
        </figure>
      </div>

      <!-- Right Company Narrative + 3 Divided Architectural Pillars -->
      <div class="lg:col-span-7 space-y-8 reveal reveal-delay-1">
        <div class="space-y-4">
          <h2 class="text-[#111D2E] dark:text-white text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight">
            Pengembang &amp; Kontraktor Perumahan Lokal Pamekasan
          </h2>
          <p class="text-slate-600 dark:text-slate-300 text-base sm:text-lg leading-relaxed font-medium max-w-2xl">
            <strong class="text-[#111D2E] dark:text-white">PT Bumi Griya Madani</strong> melalui merek <strong class="text-[#111D2E] dark:text-white">Bumi Group</strong> berfokus membangun dan memasarkan kawasan hunian berbasis klaster dan residensial di titik-titik strategis kota maupun kecamatan sekitar Kabupaten Pamekasan, Madura.
          </p>
        </div>

        <div class="divide-y divide-[#DCE3D6] dark:divide-slate-800 border-y border-[#DCE3D6] dark:border-slate-800">
          {architecturalPillars.map((pillar) => (
            <div class="py-6 flex items-start gap-4">
              <div class="w-11 h-11 rounded-xl bg-brand-50 dark:bg-brand-950/70 border border-brand-200 dark:border-brand-800 text-brand-700 dark:text-brand-400 flex items-center justify-center shrink-0 mt-0.5">
                <Icon name={pillar.icon} class="w-5 h-5" aria-hidden="true" />
              </div>
              <div class="space-y-1">
                <h3 class="text-[#111D2E] dark:text-white text-lg sm:text-xl font-extrabold">
                  {pillar.title}
                </h3>
                <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base font-medium leading-relaxed">
                  {pillar.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
