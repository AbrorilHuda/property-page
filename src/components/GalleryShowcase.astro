---
import { Image } from 'astro:assets';
import tipe36 from '../assets/images/tipe_36.png';
import livingRoom from '../assets/images/living_room.png';
import tipe45 from '../assets/images/tipe_45.png';
import facilityGate from '../assets/images/facility_gate.png';
import tipe60 from '../assets/images/tipe_60.png';
import heroHouse from '../assets/images/hero_house.png';

const galleryItems = [
  {
    title: 'Fasad Minimalis Tipe 36',
    category: 'eksterior',
    image: tipe36,
    desc: 'Desain tampak depan modern dengan carport luas & taman asri.'
  },
  {
    title: 'Ruang Tamu & Utilitas Modern',
    category: 'interior',
    image: livingRoom,
    desc: 'Interior hangat dengan pencahayaan alami optimal.'
  },
  {
    title: 'Cluster Tipe 45 Tropical',
    category: 'eksterior',
    image: tipe45,
    desc: 'Model 1.5 lantai dengan aksen kayu sintetis modern.'
  },
  {
    title: 'Gerbang Utama & Keamanan 24 Jam',
    category: 'fasilitas',
    image: facilityGate,
    desc: 'One Gate System dengan pos sekuriti & CCTV terpadu.'
  },
  {
    title: 'Tipe 60 Premium 2-Lantai',
    category: 'eksterior',
    image: tipe60,
    desc: 'Hunian mewah 2 lantai dengan balkon & kaca lebar.'
  },
  {
    title: 'Kawasan Perumahan Asri',
    category: 'fasilitas',
    image: heroHouse,
    desc: 'Lingkungan hijau bebas banjir untuk kenyamanan keluarga.'
  },
];

const filters = [
  { value: 'all', label: 'Semua Foto' },
  { value: 'eksterior', label: 'Eksterior Rumah' },
  { value: 'interior', label: 'Interior Hunian' },
  { value: 'fasilitas', label: 'Fasilitas Kawasan' },
];
---

<section id="gallery" class="py-20 md:py-28 bg-white relative">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6">

    <!-- Section Header -->
    <div class="reveal text-center max-w-3xl mx-auto mb-12 space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-100 border border-brand-300 text-brand-800 text-xs sm:text-sm font-bold uppercase tracking-wider">
        Galeri Perumahan
      </div>
      <h2 class="text-slate-900 text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight">
        Intip Suasana & Visual Hunian Bumi Group
      </h2>
      <p class="text-slate-700 text-base sm:text-lg font-medium">
        Lihat langsung keindahan arsitektur eksterior, penataan interior, serta lingkungan kawasan yang siap Anda huni.
      </p>
    </div>

    <!-- Category Filter Tabs -->
    <div class="reveal reveal-delay-1 flex flex-wrap justify-center gap-3 mb-12" role="group" aria-label="Filter galeri berdasarkan kategori">
      {filters.map((f, i) => (
        <button
          type="button"
          data-filter={f.value}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class={`filter-btn min-h-11 px-6 py-2.5 rounded-full text-xs sm:text-sm font-bold shadow-md transition-colors ${i === 0
            ? 'bg-slate-900 text-white border border-slate-900'
            : 'bg-slate-100 text-slate-800 border border-slate-300 hover:bg-slate-200'}`}
        >
          {f.label}
        </button>
      ))}
    </div>

    <!-- Gallery Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {galleryItems.map((item, idx) => (
        <div
          data-category={item.category}
          role="button"
          tabindex="0"
          aria-label={`Perbesar foto: ${item.title}`}
          class={`reveal reveal-delay-${(idx % 3) + 1} hover-lift gallery-item group relative bg-slate-900 rounded-3xl overflow-hidden shadow-card border border-slate-200 cursor-pointer focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-2`}
          data-index={idx}
        >
          <div class="relative h-72 overflow-hidden">
            <Image
              src={item.image}
              alt={item.title}
              widths={[480, 800, 1200]}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"></div>
          </div>

          <div class="absolute bottom-0 left-0 right-0 p-6 text-white bg-slate-900/90 border-t border-slate-800">
            <span class="inline-block bg-brand-700 text-white text-[11px] font-extrabold uppercase px-3 py-1 rounded-full mb-2">
              {item.category}
            </span>
            <h3 class="text-lg font-extrabold text-white mb-1 group-hover:text-brand-400 transition-colors">{item.title}</h3>
            <p class="text-xs text-slate-200 font-semibold">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<!-- Lightbox Modal -->
<div
  id="gallery-lightbox"
  class="fixed inset-0 z-80 hidden bg-slate-950/90 flex items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="lightbox-title"
>
  <button
    id="lightbox-close"
    class="absolute top-6 right-6 text-white hover:text-brand-400 text-2xl font-bold p-3 min-w-11 min-h-11 flex items-center justify-center bg-slate-800 rounded-full hover:rotate-90 transition-transform duration-200"
    aria-label="Tutup foto"
  >
    ✕
  </button>
  <div class="max-w-4xl w-full text-center space-y-4">
    <img id="lightbox-img" src="" alt="" class="max-h-[75vh] mx-auto rounded-2xl shadow-2xl object-contain border border-slate-700" />
    <h3 id="lightbox-title" class="text-white text-xl font-extrabold"></h3>
    <p id="lightbox-desc" class="text-slate-200 text-sm max-w-lg mx-auto font-medium"></p>
  </div>
</div>

<script>
  import { openDialog, closeDialog, isDialogOpen, dialogKeydown, backdropClick } from '../utils/dialog';

  const filterBtns = document.querySelectorAll('.filter-btn');
  const galleryItems = document.querySelectorAll<HTMLElement>('.gallery-item');
  const lightbox = document.getElementById('gallery-lightbox');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.setAttribute('aria-pressed', 'false');
        b.classList.remove('bg-slate-900', 'text-white', 'border-slate-900');
        b.classList.add('bg-slate-100', 'text-slate-800', 'border-slate-300');
      });
      btn.setAttribute('aria-pressed', 'true');
      btn.classList.remove('bg-slate-100', 'text-slate-800', 'border-slate-300');
      btn.classList.add('bg-slate-900', 'text-white', 'border-slate-900');

      const filter = btn.getAttribute('data-filter');
      galleryItems.forEach(item => {
        const cat = item.getAttribute('data-category');
        (item as HTMLElement).style.display = filter === 'all' || cat === filter ? 'block' : 'none';
      });
    });
  });

  function openLightbox(item: HTMLElement) {
    if (!lightbox) return;
    const img = item.querySelector('img');
    const title = item.querySelector('h3');
    const desc = item.querySelector('p');

    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxDesc = document.getElementById('lightbox-desc');

    if (lightboxImg && img) {
      lightboxImg.src = img.src;
      lightboxImg.alt = title?.textContent || '';
    }
    if (lightboxTitle && title) lightboxTitle.textContent = title.textContent;
    if (lightboxDesc && desc) lightboxDesc.textContent = desc.textContent;

    openDialog(lightbox);
  }

  galleryItems.forEach(item => {
    item.addEventListener('click', () => openLightbox(item));
    item.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openLightbox(item);
      }
    });
  });

  document.getElementById('lightbox-close')?.addEventListener('click', () => {
    if (lightbox) closeDialog(lightbox);
  });

  lightbox?.addEventListener('keydown', (e) => dialogKeydown(lightbox, e as KeyboardEvent));
  lightbox?.addEventListener('click', (e) => backdropClick(lightbox, e as MouseEvent));

  // Guard: lightbox terbuka saat filter berubah — cukup biarkan; state ditutup oleh Escape/close.
  if (lightbox && isDialogOpen(lightbox)) closeDialog(lightbox);
</script>
