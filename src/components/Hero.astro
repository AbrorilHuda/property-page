---
import { whatsappLink } from '../utils/config';
---

<section id="hero" class="relative min-h-[100dvh] flex items-center pt-24 pb-16 lg:py-32 bg-slate-950 overflow-hidden text-white">
  <!-- Serene Background Photo -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero_serene_house.png"
      alt="Perumahan Asri dan Modern Bumi Group"
      class="w-full h-full object-cover object-center brightness-[0.45] transition-transform duration-1000 ease-out scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/70 to-slate-950/20"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-slate-950/50"></div>
  </div>

  <div class="relative z-10 max-w-[1280px] mx-auto px-4 sm:px-6 w-full">
    <div class="max-w-3xl space-y-8">

      <!-- Main Headline (Reveal Animation) -->
      <h1 class="reveal active text-white text-3xl sm:text-5xl md:text-6xl font-extrabold leading-[1.12] tracking-tight">
        Hunian Asri, Tenang & Modern <br class="hidden sm:block" />
        <span class="text-emerald-400">untuk Masa Depan Keluarga</span>
      </h1>

      <!-- Subheadline (Reveal Animation) -->
      <p class="reveal active reveal-delay-1 text-slate-100 text-base sm:text-lg md:text-xl font-medium leading-relaxed max-w-2xl">
        Wujudkan rumah impian berarsitektur modern di lingkungan asri, tenang, dan aman 24 jam bersama <strong class="text-white">Bumi Group</strong>.
      </p>

      <!-- CTA Buttons (Reveal Animation) -->
      <div class="reveal active reveal-delay-2 pt-2 flex flex-col sm:flex-row gap-4 items-stretch sm:items-center">
        <a
          href={whatsappLink('Halo Sales Bumi Group, saya tertarik dengan informasi perumahan asri & modern.')}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-3 bg-emerald-600 hover:bg-emerald-500 text-white px-8 py-4 rounded-xl text-base font-bold shadow-lg hover:scale-105 active:scale-95 transition-all duration-200 min-h-[52px]"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          <span>Konsultasi Sales WA</span>
        </a>

        <a
          href="#property-types"
          class="inline-flex items-center justify-center gap-2 bg-slate-900/80 hover:bg-slate-800 border border-slate-700 text-white px-7 py-4 rounded-xl text-base font-bold transition-all duration-200 min-h-[52px]"
        >
          <span>Lihat Pilihan Tipe Unit</span>
          <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </a>
      </div>

      <!-- Minimal Highlights Strip -->
      <div class="reveal active reveal-delay-3 pt-8 border-t border-slate-800/80 grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs sm:text-sm font-semibold text-slate-200">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          <span>100% Legalitas SHM & IMB</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          <span>Lingkungan Asri & Bebas Banjir</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          <span>Keamanan One Gate System 24/7</span>
        </div>
      </div>

    </div>
  </div>
</section>
