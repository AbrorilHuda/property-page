---
import { whatsappLink } from '../utils/config';
---

<section id="hero" class="relative min-h-[85vh] md:min-h-[90vh] flex items-center justify-center bg-bumi-navy-dark overflow-hidden">
  <!-- Background gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-br from-bumi-navy-dark via-bumi-navy-light/90 to-bumi-green-dark/30"></div>

  <!-- Decorative elements -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute -top-1/2 -right-1/4 w-[600px] h-[600px] bg-bumi-green-dark/10 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-1/3 -left-1/4 w-[500px] h-[500px] bg-bumi-green-light/10 rounded-full blur-3xl"></div>
  </div>

  <div class="relative z-10 max-w-[1280px] mx-auto px-4 sm:px-6 py-20 text-center">
    <h1 class="text-white text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] font-bold leading-tight mb-6 max-w-4xl mx-auto">
      Pilihan Tepat,<br />Hunian Masa Depan Anda
    </h1>

    <p class="text-white/80 text-base sm:text-lg md:text-xl max-w-2xl mx-auto mb-10 leading-relaxed">
      Wujudkan rumah impian keluarga di lingkungan asri, aman, dan strategis bersama Bumi Group — developer terpercaya untuk investasi masa depan Anda.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a
        href={whatsappLink('Halo, saya tertarik dengan perumahan Bumi Group. Boleh info lebih lanjut?')}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-bumi-green-dark text-white px-8 py-4 rounded-xl text-base font-semibold hover:bg-bumi-green-medium transition-all duration-200 min-h-[48px] shadow-lg hover:shadow-xl hover:scale-[1.02]"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Konsultasi Gratis Sekarang
      </a>

      <a
        href="#property-types"
        class="inline-flex items-center gap-2 border-2 border-white/40 text-white px-8 py-4 rounded-xl text-base font-semibold hover:border-white/80 hover:bg-white/10 transition-all duration-200 min-h-[48px]"
      >
        Lihat Unit Tersedia
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </a>
    </div>
  </div>
</section>
