---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { whatsappLink } from '../utils/config';
import heroStreetImg from '../assets/images/cluster_street_minimalist.jpg';
---

<section id="hero" class="relative min-h-[100dvh] flex items-center pt-24 pb-12 lg:pb-16 bg-canvas-light dark:bg-canvas-dark overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">

      <!-- Left Architectural Copy (strictly max 4 text elements) -->
      <div class="lg:col-span-6 space-y-6">
        <p class="reveal active text-xs font-bold uppercase tracking-[0.16em] text-brand-700 dark:text-brand-400">
          PT Bumi Griya Madani · Pamekasan
        </p>

        <h1 class="reveal active reveal-delay-1 text-[#111D2E] dark:text-white text-4xl sm:text-5xl lg:text-[3.5rem] font-extrabold leading-[1.08] tracking-tight">
          Hunian Modern Minimalis
          <span class="block text-brand-700 dark:text-brand-400">di Klaster Strategis Pamekasan</span>
        </h1>

        <p class="reveal active reveal-delay-2 text-slate-600 dark:text-slate-300 text-base sm:text-lg font-medium leading-relaxed max-w-xl">
          Kawasan hunian klaster tertata dengan tata ruang efisien dari Bumi Group di titik strategis Pamekasan, Madura.
        </p>

        <div class="reveal active reveal-delay-3 pt-2 flex flex-wrap gap-3.5 items-center">
          <a
            href={whatsappLink('Halo Admin Bumi Group Pamekasan, saya ingin konsultasi dan info unit klaster yang tersedia.')}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 bg-brand-700 hover:bg-brand-800 text-white px-6 py-3.5 rounded-xl text-sm sm:text-base font-bold shadow-sm active:scale-[0.98] transition-all duration-200 min-h-12 whitespace-nowrap"
          >
            <Icon name="ph:whatsapp-logo-fill" class="w-5 h-5 shrink-0" aria-hidden="true" />
            <span>Konsultasi WhatsApp</span>
          </a>

          <a
            href="#proyek"
            class="inline-flex items-center justify-center gap-2 bg-white dark:bg-surface-dark hover:bg-canvas-muted dark:hover:bg-surface-dark-elevated border border-[#DCE3D6] dark:border-slate-700 text-[#111D2E] dark:text-white px-6 py-3.5 rounded-xl text-sm sm:text-base font-bold active:scale-[0.98] transition-all duration-200 min-h-12 whitespace-nowrap"
          >
            <span>Lihat Proyek</span>
            <Icon name="ph:arrow-down-right-bold" class="w-4 h-4 text-brand-700 dark:text-brand-400 shrink-0" aria-hidden="true" />
          </a>
        </div>
      </div>

      <!-- Right Architectural Visual (No overlaid pills/tags) -->
      <div class="lg:col-span-6 reveal active reveal-delay-2">
        <figure class="space-y-3">
          <div class="rounded-2xl overflow-hidden border border-[#DCE3D6] dark:border-slate-800 shadow-card bg-white dark:bg-surface-dark">
            <Image
              src={heroStreetImg}
              alt="Kawasan hunian klaster modern minimalis Bumi Group di Pamekasan"
              widths={[640, 960, 1440]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              loading="eager"
              fetchpriority="high"
              class="w-full aspect-[4/3] lg:aspect-[16/12] object-cover"
            />
          </div>
          <figcaption class="flex flex-wrap items-center justify-between gap-2 text-xs sm:text-sm font-semibold text-slate-600 dark:text-slate-400 px-1">
            <span>Ilustrasi kawasan klaster modern minimalis Bumi Group</span>
            <span class="text-brand-700 dark:text-brand-400 font-bold">Kangenan · Tlanakan · Pademawu · Bugih</span>
          </figcaption>
        </figure>
      </div>

    </div>
  </div>
</section>
