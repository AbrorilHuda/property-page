---
import { Icon } from 'astro-icon/components';
import { whatsappLink } from '../utils/config';

const navLinks = [
  { href: '/#hero', label: 'Beranda' },
  { href: '/#proyek', label: 'Proyek' },
  { href: '/#konsep', label: 'Konsep' },
  { href: '/#tipe-unit', label: 'Tipe Unit' },
  { href: '/#galeri', label: 'Galeri' },
  { href: '/#simulasi-kpr', label: 'Simulasi KPR' },
  { href: '/report', label: 'Lapor Keluhan' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-canvas-light/95 dark:bg-canvas-dark/95 backdrop-blur-md border-b border-[#DCE3D6] dark:border-slate-800 no-print transition-colors duration-200">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-18 gap-4" aria-label="Navigasi utama">
    <a href="/#hero" class="flex items-center gap-3 shrink-0 group transition-transform duration-200 hover:scale-[1.01]">
      <span class="bg-white px-2.5 py-1.5 rounded-xl border border-slate-200/80 dark:border-transparent inline-flex items-center">
        <img
          src="/bumigrouplogo.png"
          alt="Logo Bumi Group"
          class="h-8 sm:h-9 w-auto object-contain"
          loading="eager"
        />
      </span>
      <span class="sr-only">Bumi Group - PT Bumi Griya Madani Pamekasan</span>
    </a>

    <ul class="hidden lg:flex items-center gap-5 xl:gap-6 text-sm font-semibold text-slate-700 dark:text-slate-200">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="whitespace-nowrap hover:text-brand-700 dark:hover:text-brand-400 transition-colors inline-flex items-center min-h-11"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2.5 shrink-0">
      <button
        type="button"
        id="theme-toggle"
        class="min-w-11 min-h-11 inline-flex items-center justify-center rounded-xl border border-[#DCE3D6] dark:border-slate-700 bg-white dark:bg-surface-dark text-slate-700 dark:text-slate-200 hover:border-brand-700 dark:hover:border-brand-400 transition-colors"
        aria-label="Ubah mode tampilan gelap atau terang"
      >
        <Icon name="ph:moon-bold" class="w-5 h-5 block dark:hidden" aria-hidden="true" />
        <Icon name="ph:sun-bold" class="w-5 h-5 hidden dark:block text-brand-400" aria-hidden="true" />
      </button>

      <a
        href={whatsappLink('Halo Admin Bumi Group Pamekasan, saya ingin konsultasi mengenai unit perumahan yang tersedia.')}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 bg-brand-700 hover:bg-brand-800 text-white px-5 py-2.5 rounded-xl text-sm font-bold shadow-sm active:scale-[0.98] transition-all duration-200 min-h-11 whitespace-nowrap"
      >
        <Icon name="ph:whatsapp-logo-fill" class="w-4 h-4 shrink-0" aria-hidden="true" />
        <span>Konsultasi WhatsApp</span>
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="lg:hidden flex flex-col gap-1.25 p-2 min-w-11 min-h-11 items-center justify-center rounded-xl border border-[#DCE3D6] dark:border-slate-700 bg-white dark:bg-surface-dark hover:border-brand-700 transition-colors"
        aria-label="Buka menu navigasi"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block w-5 h-0.5 bg-slate-900 dark:bg-white transition-all" id="bar1"></span>
        <span class="block w-5 h-0.5 bg-slate-900 dark:bg-white transition-all" id="bar2"></span>
        <span class="block w-5 h-0.5 bg-slate-900 dark:bg-white transition-all" id="bar3"></span>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile Menu Overlay: inert saat tertutup agar tidak bisa di-Tab -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-60 bg-canvas-dark text-white transition-transform duration-300 lg:hidden no-print"
  role="dialog"
  aria-modal="true"
  aria-label="Menu navigasi"
  inert
>
  <div class="flex flex-col h-full p-6 justify-between">
    <div>
      <div class="flex justify-between items-center mb-8 border-b border-slate-800 pb-4">
        <div class="bg-white px-3 py-2 rounded-xl">
          <img src="/bumigrouplogo.png" alt="Logo Bumi Group" class="h-8 w-auto" />
        </div>
        <button
          id="menu-close"
          type="button"
          class="text-white min-w-11 min-h-11 flex items-center justify-center rounded-xl bg-surface-dark border border-slate-700 hover:border-brand-400 transition-colors"
          aria-label="Tutup menu"
        >
          <Icon name="ph:x-bold" class="w-5 h-5" aria-hidden="true" />
        </button>
      </div>

      <ul class="flex flex-col gap-1.5 text-white text-lg font-bold">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="mobile-nav-link block py-3 px-4 rounded-xl hover:bg-surface-dark-elevated transition-colors">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="pt-6 border-t border-slate-800">
      <a
        href={whatsappLink('Halo Admin Bumi Group Pamekasan, saya ingin konsultasi mengenai unit perumahan yang tersedia.')}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2.5 w-full bg-brand-700 hover:bg-brand-800 text-white py-3.5 px-5 rounded-xl font-bold min-h-12"
      >
        <Icon name="ph:whatsapp-logo-fill" class="w-5 h-5" aria-hidden="true" />
        <span>Konsultasi WhatsApp</span>
      </a>
    </div>
  </div>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const closeBtn = document.getElementById('menu-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');
  const themeToggle = document.getElementById('theme-toggle');

  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('bumi-theme', isDark ? 'dark' : 'light');
    } catch (_) {}
  });

  function openMenu() {
    if (!menu) return;
    menu.inert = false;
    menu.classList.add('menu-open');
    toggle?.classList.add('menu-open');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    menu.querySelector<HTMLElement>('a, button')?.focus();
  }

  function closeMenu() {
    if (!menu) return;
    menu.classList.remove('menu-open');
    menu.inert = true;
    toggle?.classList.remove('menu-open');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    toggle?.focus();
  }

  const isMenuOpen = () => menu?.classList.contains('menu-open') ?? false;

  toggle?.addEventListener('click', () => {
    isMenuOpen() ? closeMenu() : openMenu();
  });

  closeBtn?.addEventListener('click', closeMenu);

  mobileLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen()) closeMenu();
  });
</script>

<style is:global>
  #mobile-menu {
    translate: 100% 0;
  }

  #mobile-menu.menu-open {
    translate: 0 0;
  }

  #menu-toggle span {
    transition-property: rotate, translate, opacity;
    transition-duration: 0.25s;
  }

  #menu-toggle.menu-open #bar1 { rotate: 45deg; translate: 0 7px; }
  #menu-toggle.menu-open #bar2 { opacity: 0; }
  #menu-toggle.menu-open #bar3 { rotate: -45deg; translate: 0 -7px; }
</style>
