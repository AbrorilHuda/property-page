---
import { whatsappLink } from '../utils/config';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';

const navLinks = [
  { href: '/#hero', label: 'Beranda' },
  { href: '/#about', label: 'Tentang Kami' },
  { href: '/#property-types', label: 'Tipe Rumah' },
  { href: '/#kpr-calculator', label: 'Simulasi KPR' },
  { href: '/#facilities', label: 'Fasilitas' },
  { href: '/#gallery', label: 'Galeri' },
  { href: '/report', label: 'Lapor Keluhan' },
  { href: '/#contact', label: 'Kontak' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-slate-200 shadow-sm no-print" aria-label="Navigasi utama">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-20 gap-4">
    <a href="/#hero" class="flex items-center gap-3 group transition-transform duration-200 hover:scale-[1.02]">
      <img
        src="/bumigrouplogo.png"
        alt=""
        class="h-10 sm:h-12 w-auto object-contain"
        loading="eager"
      />
      <span class="sr-only">Bumi Group - Perumahan Terpercaya</span>
    </a>

    <ul class="hidden lg:flex items-center gap-6 text-sm font-bold text-slate-800">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="nav-link hover:text-brand-700 transition-all duration-200 inline-flex items-center min-h-11 relative">{link.label}</a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <a
        href={whatsappLink('Halo, saya tertarik dengan perumahan Bumi Group. Boleh minta info katalog lengkap?')}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2.5 bg-brand-700 hover:bg-brand-800 text-white px-5 py-2.5 rounded-full text-sm font-bold shadow-md transition-all duration-300 min-h-11"
      >
        <WhatsAppIcon class="w-4 h-4 fill-current" />
        <span>Konsultasi WA</span>
      </a>

      <button
        id="menu-toggle"
        class="lg:hidden flex flex-col gap-1.25 p-2 min-w-11 min-h-11 items-center justify-center rounded-lg hover:bg-slate-100 transition-colors"
        aria-label="Buka menu navigasi"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block w-6 h-0.5 bg-slate-900 transition-all" id="bar1"></span>
        <span class="block w-6 h-0.5 bg-slate-900 transition-all" id="bar2"></span>
        <span class="block w-6 h-0.5 bg-slate-900 transition-all" id="bar3"></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Menu Overlay: inert saat tertutup agar tidak bisa di-Tab -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-60 bg-slate-900 transition-transform duration-300 lg:hidden no-print"
  role="dialog"
  aria-modal="true"
  aria-label="Menu navigasi"
  inert
>
  <div class="flex flex-col h-full p-6">
    <div class="flex justify-between items-center mb-8 border-b border-slate-800 pb-4">
      <div class="bg-white p-2 rounded-lg">
        <img src="/bumigrouplogo.png" alt="Logo Bumi Group" class="h-8 w-auto" />
      </div>
      <button
        id="menu-close"
        class="text-white min-w-11 min-h-11 flex items-center justify-center text-2xl font-bold rounded-lg hover:bg-slate-800 transition-colors"
        aria-label="Tutup menu"
      >
        ✕
      </button>
    </div>

    <ul class="flex flex-col gap-2 text-white text-lg font-bold">
      {navLinks.map((link) => (
        <li><a href={link.href} class="mobile-nav-link block py-3 px-4 rounded-xl hover:bg-slate-800 transition-colors">{link.label}</a></li>
      ))}
    </ul>
  </div>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const closeBtn = document.getElementById('menu-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function openMenu() {
    if (!menu) return;
    menu.inert = false;
    menu.classList.add('menu-open');
    toggle?.classList.add('menu-open');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    menu.querySelector<HTMLElement>('a, button')?.focus();
  }

  function closeMenu() {
    if (!menu) return;
    menu.classList.remove('menu-open');
    menu.inert = true;
    toggle?.classList.remove('menu-open');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    toggle?.focus();
  }

  const isMenuOpen = () => menu?.classList.contains('menu-open') ?? false;

  toggle?.addEventListener('click', () => {
    isMenuOpen() ? closeMenu() : openMenu();
  });

  closeBtn?.addEventListener('click', closeMenu);

  mobileLinks.forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen()) closeMenu();
  });
</script>

<style is:global>
  /* Geser menu keluar layar saat tertutup; properti translate dipakai langsung
     agar tidak bergantung pada utility Tailwind yang ditambahkan lewat JS. */
  #mobile-menu {
    translate: 100% 0;
  }

  #mobile-menu.menu-open {
    translate: 0 0;
  }

  /* Morph hamburger menjadi ✕ saat menu terbuka */
  #menu-toggle span {
    transition-property: rotate, translate, opacity;
    transition-duration: 0.3s;
  }

  #menu-toggle.menu-open #bar1 { rotate: 45deg; translate: 0 7px; }
  #menu-toggle.menu-open #bar2 { opacity: 0; }
  #menu-toggle.menu-open #bar3 { rotate: -45deg; translate: 0 -7px; }
</style>

