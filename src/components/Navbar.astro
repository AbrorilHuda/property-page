---
import { whatsappLink } from '../utils/config';
---

<nav class="fixed top-0 left-0 right-0 z-[1000] bg-white border-b border-slate-200 shadow-sm no-print" aria-label="Navigasi utama">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 flex items-center justify-between h-20">
    <a href="#hero" class="flex items-center gap-3 group transition-transform duration-200 hover:scale-[1.02]">
      <img
        src="/bumigrouplogo.png"
        alt="Bumi Group Logo"
        class="h-10 sm:h-12 w-auto object-contain"
        loading="eager"
      />
      <span class="sr-only">Bumi Group - Perumahan Terpercaya</span>
    </a>

    <ul class="hidden md:flex items-center gap-7 text-sm font-bold text-slate-800">
      <li><a href="#hero" class="nav-link hover:text-emerald-700 transition-all duration-200 py-2 relative">Beranda</a></li>
      <li><a href="#about" class="nav-link hover:text-emerald-700 transition-all duration-200 py-2 relative">Tentang Kami</a></li>
      <li><a href="#property-types" class="nav-link hover:text-emerald-700 transition-all duration-200 py-2 relative">Tipe Rumah</a></li>
      <li><a href="#kpr-calculator" class="nav-link hover:text-emerald-700 transition-all duration-200 py-2 relative">Simulasi KPR</a></li>
      <li><a href="#facilities" class="nav-link hover:text-emerald-700 transition-all duration-200 py-2 relative">Fasilitas</a></li>
      <li><a href="#gallery" class="nav-link hover:text-emerald-700 transition-all duration-200 py-2 relative">Galeri</a></li>
      <li><a href="#contact" class="nav-link hover:text-emerald-700 transition-all duration-200 py-2 relative">Kontak</a></li>
    </ul>

    <div class="flex items-center gap-3">
      <a
        href={whatsappLink('Halo, saya tertarik dengan perumahan Bumi Group. Boleh minta info katalog lengkap?')}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2.5 bg-emerald-700 hover:bg-emerald-800 text-white px-5 py-2.5 rounded-full text-sm font-bold shadow-md transition-all duration-300 min-h-[44px]"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        <span>Konsultasi WA</span>
      </a>

      <button
        id="menu-toggle"
        class="md:hidden flex flex-col gap-[5px] p-2 min-w-[44px] min-h-[44px] items-center justify-center rounded-lg hover:bg-slate-100 transition-colors"
        aria-label="Buka menu navigasi"
        aria-expanded="false"
      >
        <span class="block w-6 h-0.5 bg-slate-900 transition-all" id="bar1"></span>
        <span class="block w-6 h-0.5 bg-slate-900 transition-all" id="bar2"></span>
        <span class="block w-6 h-0.5 bg-slate-900 transition-all" id="bar3"></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Menu Overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[999] bg-slate-900 transform translate-x-full transition-transform duration-300 md:hidden no-print"
  role="dialog"
  aria-label="Menu navigasi"
  aria-hidden="true"
>
  <div class="flex flex-col h-full p-6">
    <div class="flex justify-between items-center mb-8 border-b border-slate-800 pb-4">
      <div class="bg-white p-2 rounded-lg">
        <img src="/bumigrouplogo.png" alt="Logo" class="h-8 w-auto" />
      </div>
      <button
        id="menu-close"
        class="text-white min-w-[44px] min-h-[44px] flex items-center justify-center text-2xl font-bold"
        aria-label="Tutup menu"
      >
        ✕
      </button>
    </div>

    <ul class="flex flex-col gap-2 text-white text-lg font-bold">
      <li><a href="#hero" class="mobile-nav-link block py-3 px-4 rounded-xl hover:bg-slate-800 transition-colors">Beranda</a></li>
      <li><a href="#about" class="mobile-nav-link block py-3 px-4 rounded-xl hover:bg-slate-800 transition-colors">Tentang Kami</a></li>
      <li><a href="#property-types" class="mobile-nav-link block py-3 px-4 rounded-xl hover:bg-slate-800 transition-colors">Tipe Rumah</a></li>
      <li><a href="#kpr-calculator" class="mobile-nav-link block py-3 px-4 rounded-xl hover:bg-slate-800 transition-colors">Simulasi KPR</a></li>
      <li><a href="#facilities" class="mobile-nav-link block py-3 px-4 rounded-xl hover:bg-slate-800 transition-colors">Fasilitas</a></li>
      <li><a href="#gallery" class="mobile-nav-link block py-3 px-4 rounded-xl hover:bg-slate-800 transition-colors">Galeri</a></li>
      <li><a href="#contact" class="mobile-nav-link block py-3 px-4 rounded-xl hover:bg-slate-800 transition-colors">Kontak</a></li>
    </ul>

    <div class="mt-auto">
      <a
        href={whatsappLink('Halo, saya tertarik dengan perumahan Bumi Group')}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 bg-emerald-600 text-white px-6 py-3.5 rounded-xl text-base font-bold hover:bg-emerald-700 transition-colors"
      >
        Chat WhatsApp Sekarang
      </a>
    </div>
  </div>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const closeBtn = document.getElementById('menu-close');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const bar3 = document.getElementById('bar3');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function openMenu() {
    menu?.classList.remove('translate-x-full');
    menu?.classList.add('translate-x-0');
    menu?.setAttribute('aria-hidden', 'false');
    toggle?.setAttribute('aria-expanded', 'true');
    bar1?.classList.add('rotate-45', 'translate-y-[7px]');
    bar2?.classList.add('opacity-0');
    bar3?.classList.add('-rotate-45', '-translate-y-[7px]');
  }

  function closeMenu() {
    menu?.classList.add('translate-x-full');
    menu?.classList.remove('translate-x-0');
    menu?.setAttribute('aria-hidden', 'true');
    toggle?.setAttribute('aria-expanded', 'false');
    bar1?.classList.remove('rotate-45', 'translate-y-[7px]');
    bar2?.classList.remove('opacity-0');
    bar3?.classList.remove('-rotate-45', '-translate-y-[7px]');
  }

  toggle?.addEventListener('click', () => {
    if (menu?.classList.contains('translate-x-full')) {
      openMenu();
    } else {
      closeMenu();
    }
  });

  closeBtn?.addEventListener('click', closeMenu);

  mobileLinks.forEach(link => {
    link.addEventListener('click', closeMenu);
  });
</script>
