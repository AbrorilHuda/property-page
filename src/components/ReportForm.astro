---
import { Icon } from 'astro-icon/components';
import { bumiProjects } from '../data/bumiGroup';

const clusterProjects = bumiProjects.filter((p) => p.category === 'Klaster Hunian');
---

<div class="bg-white dark:bg-surface-dark rounded-2xl p-6 sm:p-8 lg:p-10 shadow-card border border-[#DCE3D6] dark:border-slate-800 text-[#111D2E] dark:text-white">
  <div class="mb-7 space-y-2 border-b border-[#DCE3D6] dark:border-slate-800 pb-5">
    <h2 class="text-xl sm:text-2xl font-extrabold tracking-tight">Formulir Laporan Keluhan</h2>
    <p class="text-slate-600 dark:text-slate-300 text-sm font-medium leading-relaxed">
      Lengkapi data kavling dan klaster perumahan Anda agar tim admin terkait segera menindaklanjuti.
    </p>
  </div>

  <form id="report-form" class="space-y-5" novalidate>
    <div class="grid sm:grid-cols-2 gap-5">
      <!-- ID Kavling -->
      <div class="space-y-1.5">
        <label for="idKavling" class="block text-sm font-bold text-[#111D2E] dark:text-white">
          ID Kavling / Blok <span class="text-red-600 dark:text-red-400" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="idKavling"
          name="idKavling"
          required
          autocomplete="off"
          aria-describedby="error-idKavling hint-idKavling"
          class="w-full px-4 py-3 border border-[#DCE3D6] dark:border-slate-700 bg-canvas-light dark:bg-canvas-dark rounded-xl focus:outline-none focus:border-brand-700 dark:focus:border-brand-400 transition-colors text-[#111D2E] dark:text-white font-semibold placeholder:text-slate-500 dark:placeholder:text-slate-400"
          placeholder="cth. Blok B-12"
        />
        <p id="hint-idKavling" class="text-slate-500 dark:text-slate-400 text-xs font-medium">Tertera di berkas serah terima atau surat kavling Anda.</p>
        <p id="error-idKavling" class="text-red-600 dark:text-red-400 text-xs font-bold hidden" role="alert"></p>
      </div>

      <!-- Proyek -->
      <div class="space-y-1.5">
        <label for="proyek" class="block text-sm font-bold text-[#111D2E] dark:text-white">
          Klaster Perumahan <span class="text-red-600 dark:text-red-400" aria-hidden="true">*</span>
        </label>
        <div class="relative">
          <select
            id="proyek"
            name="proyek"
            required
            autocomplete="off"
            aria-describedby="error-proyek"
            class="w-full appearance-none px-4 py-3 pr-10 border border-[#DCE3D6] dark:border-slate-700 bg-canvas-light dark:bg-canvas-dark rounded-xl focus:outline-none focus:border-brand-700 dark:focus:border-brand-400 transition-colors text-[#111D2E] dark:text-white font-semibold cursor-pointer"
          >
            <option value="" disabled selected>Pilih proyek perumahan</option>
            {clusterProjects.map((project) => (
              <option value={project.adminPhone} data-project-name={project.name}>
                {project.shortName} ({project.areaLabel})
              </option>
            ))}
          </select>
          <Icon
            name="ph:caret-down-bold"
            class="w-4 h-4 text-slate-600 dark:text-slate-400 absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none"
            aria-hidden="true"
          />
        </div>
        <p id="error-proyek" class="text-red-600 dark:text-red-400 text-xs font-bold hidden" role="alert"></p>
      </div>

      <!-- Nama Lengkap -->
      <div class="space-y-1.5">
        <label for="namaLengkap" class="block text-sm font-bold text-[#111D2E] dark:text-white">
          Nama Lengkap <span class="text-red-600 dark:text-red-400" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="namaLengkap"
          name="namaLengkap"
          required
          autocomplete="name"
          aria-describedby="error-namaLengkap"
          class="w-full px-4 py-3 border border-[#DCE3D6] dark:border-slate-700 bg-canvas-light dark:bg-canvas-dark rounded-xl focus:outline-none focus:border-brand-700 dark:focus:border-brand-400 transition-colors text-[#111D2E] dark:text-white font-semibold placeholder:text-slate-500 dark:placeholder:text-slate-400"
          placeholder="Nama sesuai data pemilik"
        />
        <p id="error-namaLengkap" class="text-red-600 dark:text-red-400 text-xs font-bold hidden" role="alert"></p>
      </div>

      <!-- No. HP / WhatsApp -->
      <div class="space-y-1.5">
        <label for="nomorWhatsApp" class="block text-sm font-bold text-[#111D2E] dark:text-white">
          No. HP / WhatsApp <span class="text-red-600 dark:text-red-400" aria-hidden="true">*</span>
        </label>
        <input
          type="tel"
          id="nomorWhatsApp"
          name="nomorWhatsApp"
          required
          autocomplete="tel"
          inputmode="tel"
          aria-describedby="error-nomorWhatsApp"
          class="w-full px-4 py-3 border border-[#DCE3D6] dark:border-slate-700 bg-canvas-light dark:bg-canvas-dark rounded-xl focus:outline-none focus:border-brand-700 dark:focus:border-brand-400 transition-colors text-[#111D2E] dark:text-white font-semibold placeholder:text-slate-500 dark:placeholder:text-slate-400"
          placeholder="Contoh: 0823xxxxxxxx"
        />
        <p id="error-nomorWhatsApp" class="text-red-600 dark:text-red-400 text-xs font-bold hidden" role="alert"></p>
      </div>
    </div>

    <!-- Detail Keluhan -->
    <div class="space-y-1.5">
      <label for="keluhan" class="block text-sm font-bold text-[#111D2E] dark:text-white">
        Detail Keluhan <span class="text-red-600 dark:text-red-400" aria-hidden="true">*</span>
      </label>
      <textarea
        id="keluhan"
        name="keluhan"
        rows="5"
        required
        aria-describedby="error-keluhan"
        class="w-full px-4 py-3 border border-[#DCE3D6] dark:border-slate-700 bg-canvas-light dark:bg-canvas-dark rounded-xl focus:outline-none focus:border-brand-700 dark:focus:border-brand-400 transition-colors text-[#111D2E] dark:text-white font-semibold placeholder:text-slate-500 dark:placeholder:text-slate-400 resize-none"
        placeholder="Jelaskan keluhan Anda, misalnya kondisi bangunan, saluran air, atau fasilitas lingkungan klaster..."
      ></textarea>
      <p id="error-keluhan" class="text-red-600 dark:text-red-400 text-xs font-bold hidden" role="alert"></p>
    </div>

    <button
      type="submit"
      id="report-submit-btn"
      class="w-full bg-brand-700 hover:bg-brand-800 text-white px-6 py-4 rounded-xl font-bold shadow-sm active:scale-[0.99] transition-all duration-200 min-h-12 disabled:opacity-50 disabled:cursor-not-allowed inline-flex items-center justify-center gap-2.5"
    >
      <Icon name="ph:whatsapp-logo-fill" class="w-5 h-5 shrink-0" aria-hidden="true" />
      <span>Kirim Laporan</span>
    </button>

    <div id="report-success" class="report-success-pop hidden mt-4 p-5 bg-brand-50 dark:bg-brand-950/60 border border-brand-200 dark:border-brand-800 rounded-2xl">
      <div class="flex items-start gap-3">
        <Icon name="ph:check-circle-fill" class="w-6 h-6 text-brand-700 dark:text-brand-400 shrink-0 mt-0.5" aria-hidden="true" />
        <div class="min-w-0 flex-1">
          <p class="text-brand-900 dark:text-brand-200 font-extrabold text-sm">Laporan Anda Siap Dikirim</p>
          <p class="text-brand-800 dark:text-brand-300 text-xs sm:text-sm font-medium mt-1">
            WhatsApp akan terbuka otomatis ke admin klaster terkait. Simpan nomor referensi berikut untuk pelacakan.
          </p>
          <div class="mt-3 flex items-center justify-between gap-3 border border-dashed border-brand-600/50 bg-white dark:bg-canvas-dark rounded-xl px-4 py-2.5">
            <span class="text-xs font-extrabold uppercase tracking-wider text-brand-700 dark:text-brand-400">Nomor Referensi</span>
            <span id="ticket-number" class="font-mono font-extrabold text-brand-900 dark:text-white text-sm whitespace-nowrap"></span>
          </div>
          <a
            id="report-wa-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center justify-center gap-2 bg-brand-700 hover:bg-brand-800 text-white text-xs sm:text-sm font-bold px-5 py-2.5 rounded-xl min-h-11 transition-colors"
          >
            <span>Buka WhatsApp Sekarang</span>
          </a>
        </div>
      </div>
    </div>
  </form>
</div>

<script>
  import { validateName, validateWhatsApp } from '../utils/validation';
  import { whatsappLink } from '../utils/config';

  const form = document.getElementById('report-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('report-submit-btn') as HTMLButtonElement | null;
  const successMessage = document.getElementById('report-success');
  const ticketNumber = document.getElementById('ticket-number');
  const reportWaLink = document.getElementById('report-wa-link') as HTMLAnchorElement | null;

  const idKavlingInput = document.getElementById('idKavling') as HTMLInputElement;
  const proyekSelect = document.getElementById('proyek') as HTMLSelectElement;
  const namaLengkapInput = document.getElementById('namaLengkap') as HTMLInputElement;
  const nomorWhatsAppInput = document.getElementById('nomorWhatsApp') as HTMLInputElement;
  const keluhanInput = document.getElementById('keluhan') as HTMLTextAreaElement;

  const errorEls: Record<string, HTMLElement | null> = {
    idKavling: document.getElementById('error-idKavling'),
    proyek: document.getElementById('error-proyek'),
    namaLengkap: document.getElementById('error-namaLengkap'),
    nomorWhatsApp: document.getElementById('error-nomorWhatsApp'),
    keluhan: document.getElementById('error-keluhan'),
  };

  const inputs: Record<string, HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement> = {
    idKavling: idKavlingInput,
    proyek: proyekSelect,
    namaLengkap: namaLengkapInput,
    nomorWhatsApp: nomorWhatsAppInput,
    keluhan: keluhanInput,
  };

  function showError(element: HTMLElement | null, message: string) {
    if (element) {
      element.textContent = message;
      element.classList.remove('hidden');
    }
  }

  function hideError(element: HTMLElement | null) {
    if (element) {
      element.textContent = '';
      element.classList.add('hidden');
    }
  }

  function setFieldState(field: string, message: string | null) {
    const input = inputs[field];
    const errorEl = errorEls[field];
    if (message) {
      showError(errorEl, message);
      input.classList.add('border-red-500');
      input.setAttribute('aria-invalid', 'true');
    } else {
      hideError(errorEl);
      input.classList.remove('border-red-500');
      input.removeAttribute('aria-invalid');
    }
    return !message;
  }

  const validators: Record<string, (value: string) => string | null> = {
    idKavling: (value) => (value.trim() ? null : 'ID Kavling wajib diisi'),
    proyek: (value) => (value ? null : 'Silakan pilih klaster perumahan'),
    namaLengkap: (value) => validateName(value),
    nomorWhatsApp: (value) => validateWhatsApp(value),
    keluhan: (value) => {
      const trimmed = value.trim();
      if (!trimmed) return 'Detail keluhan wajib diisi';
      if (trimmed.length < 10) return 'Jelaskan keluhan minimal 10 karakter agar tim kami memahami kendala Anda';
      return null;
    },
  };

  function validateField(field: string): boolean {
    return setFieldState(field, validators[field](inputs[field].value));
  }

  function validateForm(): boolean {
    const fields = Object.keys(validators);
    let firstInvalid: HTMLElement | null = null;
    fields.forEach((field) => {
      const ok = validateField(field);
      if (!ok && !firstInvalid) firstInvalid = inputs[field];
    });
    firstInvalid?.focus();
    return !firstInvalid;
  }

  function generateReferenceNumber(): string {
    const now = new Date();
    const dateStamp = `${now.getFullYear()}${String(now.getMonth() + 1).padStart(2, '0')}${String(now.getDate()).padStart(2, '0')}`;
    const random = Math.floor(1000 + Math.random() * 9000);
    return `RPT-${dateStamp}-${random}`;
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    successMessage?.classList.add('hidden');

    if (!validateForm()) return;

    if (submitBtn) submitBtn.disabled = true;

    const reference = generateReferenceNumber();
    const selectedOpt = proyekSelect.selectedOptions[0];
    const projectName = selectedOpt?.getAttribute('data-project-name') || selectedOpt?.textContent || proyekSelect.value;
    const targetAdminPhone = proyekSelect.value;

    const formData = {
      idKavling: idKavlingInput.value.trim(),
      proyek: projectName,
      namaLengkap: namaLengkapInput.value.trim(),
      nomorWhatsApp: nomorWhatsAppInput.value.trim(),
      keluhan: keluhanInput.value.trim(),
    };

    const message = `Halo Admin ${formData.proyek}, saya ingin melaporkan keluhan perumahan.\n\nNo. Referensi: ${reference}\nID Kavling: ${formData.idKavling}\nKlaster: ${formData.proyek}\nNama: ${formData.namaLengkap}\nNo. HP: ${formData.nomorWhatsApp}\n\nDetail Keluhan:\n${formData.keluhan}`;
    const waUrl = whatsappLink(message, targetAdminPhone);

    if (ticketNumber) ticketNumber.textContent = reference;
    if (reportWaLink) reportWaLink.href = waUrl;
    successMessage?.classList.remove('hidden');

    window.open(waUrl, '_blank', 'noopener');

    form.reset();
    Object.keys(inputs).forEach((field) => {
      inputs[field].classList.remove('border-red-500');
      inputs[field].removeAttribute('aria-invalid');
    });

    if (submitBtn) submitBtn.disabled = false;
  });

  (['idKavling', 'namaLengkap', 'nomorWhatsApp', 'keluhan'] as const).forEach((field) => {
    inputs[field]?.addEventListener('blur', () => validateField(field));
  });

  proyekSelect?.addEventListener('change', () => validateField('proyek'));
</script>

<style>
  @keyframes ticket-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .report-success-pop {
    animation: ticket-in 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .report-success-pop {
      animation: none;
    }
  }
</style>
