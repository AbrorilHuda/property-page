---
import { config } from '../utils/config';

// Dummy data proyek — nanti diganti dengan fetch ke REST API (mis. GET /api/projects)
const dummyProjects = [
  { id: 'cluster-emerald', name: 'Cluster Emerald' },
  { id: 'cluster-sapphire', name: 'Cluster Sapphire' },
  { id: 'cluster-diamond', name: 'Cluster Diamond' },
];
---

<div class="bg-white rounded-3xl p-6 sm:p-10 shadow-card border border-slate-200 text-slate-900">
  <div class="mb-8">
    <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Formulir Laporan Keluhan</h2>
    <p class="text-slate-600 text-sm sm:text-base font-medium mt-2 leading-relaxed">
      Lengkapi data di bawah ini. Laporan Anda diteruskan ke tim customer service kami dan
      ditindaklanjuti maksimal 1&times;24 jam kerja.
    </p>
  </div>

  <form id="report-form" class="space-y-6" novalidate>
    <div class="grid sm:grid-cols-2 gap-6">
      <!-- ID Kavling -->
      <div>
        <label for="idKavling" class="block text-slate-900 text-sm font-bold mb-2">
          ID Kavling <span class="text-red-600" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="idKavling"
          name="idKavling"
          required
          autocomplete="off"
          aria-describedby="error-idKavling hint-idKavling"
          class="w-full px-4 py-3.5 border-2 border-slate-300 rounded-xl focus:outline-none focus:border-brand-700 transition-colors text-slate-900 font-semibold placeholder:text-slate-500"
          placeholder="cth. K-12"
        />
        <p id="hint-idKavling" class="text-slate-500 text-xs font-medium mt-1.5">Tertera di buku serah terima atau kartu penghuni Anda.</p>
        <p id="error-idKavling" class="text-red-600 text-sm font-bold mt-1 hidden" role="alert"></p>
      </div>

      <!-- Proyek -->
      <div>
        <label for="proyek" class="block text-slate-900 text-sm font-bold mb-2">
          Proyek <span class="text-red-600" aria-hidden="true">*</span>
        </label>
        <div class="relative">
          <select
            id="proyek"
            name="proyek"
            required
            autocomplete="off"
            aria-describedby="error-proyek"
            class="w-full appearance-none px-4 py-3.5 pr-12 border-2 border-slate-300 rounded-xl focus:outline-none focus:border-brand-700 transition-colors text-slate-900 font-semibold bg-white cursor-pointer"
          >
            <option value="" disabled selected>Pilih proyek perumahan</option>
            {dummyProjects.map((project) => (
              <option value={project.id}>{project.name}</option>
            ))}
          </select>
          <svg
            class="w-5 h-5 text-slate-500 absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
        <p id="error-proyek" class="text-red-600 text-sm font-bold mt-1 hidden" role="alert"></p>
      </div>

      <!-- Nama Lengkap -->
      <div>
        <label for="namaLengkap" class="block text-slate-900 text-sm font-bold mb-2">
          Nama Lengkap <span class="text-red-600" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="namaLengkap"
          name="namaLengkap"
          required
          autocomplete="name"
          aria-describedby="error-namaLengkap"
          class="w-full px-4 py-3.5 border-2 border-slate-300 rounded-xl focus:outline-none focus:border-brand-700 transition-colors text-slate-900 font-semibold placeholder:text-slate-500"
          placeholder="Nama sesuai buku serah terima"
        />
        <p id="error-namaLengkap" class="text-red-600 text-sm font-bold mt-1 hidden" role="alert"></p>
      </div>

      <!-- No. HP / WhatsApp -->
      <div>
        <label for="nomorWhatsApp" class="block text-slate-900 text-sm font-bold mb-2">
          No. HP / WhatsApp <span class="text-red-600" aria-hidden="true">*</span>
        </label>
        <input
          type="tel"
          id="nomorWhatsApp"
          name="nomorWhatsApp"
          required
          autocomplete="tel"
          inputmode="tel"
          aria-describedby="error-nomorWhatsApp"
          class="w-full px-4 py-3.5 border-2 border-slate-300 rounded-xl focus:outline-none focus:border-brand-700 transition-colors text-slate-900 font-semibold placeholder:text-slate-500"
          placeholder="Contoh: 08123456789"
        />
        <p id="error-nomorWhatsApp" class="text-red-600 text-sm font-bold mt-1 hidden" role="alert"></p>
      </div>
    </div>

    <!-- Keluhan -->
    <div>
      <label for="keluhan" class="block text-slate-900 text-sm font-bold mb-2">
        Detail Keluhan <span class="text-red-600" aria-hidden="true">*</span>
      </label>
      <textarea
        id="keluhan"
        name="keluhan"
        rows="5"
        required
        aria-describedby="error-keluhan"
        class="w-full px-4 py-3.5 border-2 border-slate-300 rounded-xl focus:outline-none focus:border-brand-700 transition-colors text-slate-900 font-semibold placeholder:text-slate-500 resize-none"
        placeholder="Jelaskan keluhan Anda, misalnya kerusakan bangunan, kebocoran, drainase, atau fasilitas umum..."
      ></textarea>
      <p id="error-keluhan" class="text-red-600 text-sm font-bold mt-1 hidden" role="alert"></p>
    </div>

    <!-- Submit Button -->
    <button
      type="submit"
      id="report-submit-btn"
      class="w-full bg-brand-700 hover:bg-brand-800 text-white px-6 py-4 rounded-xl font-extrabold shadow-md active:scale-[0.99] transition-all duration-200 min-h-[50px] disabled:opacity-50 disabled:cursor-not-allowed"
    >
      Kirim Laporan
    </button>

    <!-- Success Message: nomor referensi + tautan WhatsApp (tahan popup blocker) -->
    <div id="report-success" class="report-success-pop hidden mt-6 p-5 bg-brand-50 border border-brand-200 rounded-2xl">
      <div class="flex items-start gap-3">
        <span class="w-8 h-8 rounded-xl bg-brand-700 text-white flex items-center justify-center shrink-0 mt-0.5" aria-hidden="true">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </span>
        <div class="min-w-0">
          <p class="text-brand-900 font-extrabold">Laporan Anda Siap Dikirim</p>
          <p class="text-brand-800 text-sm font-semibold mt-1">
            WhatsApp akan terbuka otomatis untuk meneruskan laporan ke tim customer service.
            Jika tidak terbuka, tekan tombol di bawah. Simpan nomor referensi berikut agar
            laporan mudah dilacak.
          </p>
          <div class="mt-3 flex items-center justify-between gap-3 border border-dashed border-brand-600/50 bg-white/70 rounded-xl px-4 py-2.5">
            <span class="text-xs font-extrabold uppercase tracking-wider text-brand-700">Nomor Referensi</span>
            <span id="ticket-number" class="font-mono font-extrabold text-brand-900 text-sm whitespace-nowrap"></span>
          </div>
          <a
            id="report-wa-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center justify-center gap-2 bg-brand-700 hover:bg-brand-800 text-white text-sm font-bold px-5 py-3 rounded-xl min-h-11 transition-colors"
          >
            Buka WhatsApp Sekarang
          </a>
        </div>
      </div>
    </div>
  </form>
</div>

<script>
  import { validateName, validateWhatsApp } from '../utils/validation';
  import { config, whatsappLink } from '../utils/config';

  const form = document.getElementById('report-form') as HTMLFormElement;
  const submitBtn = document.getElementById('report-submit-btn') as HTMLButtonElement;
  const successMessage = document.getElementById('report-success');
  const ticketNumber = document.getElementById('ticket-number');
  const reportWaLink = document.getElementById('report-wa-link') as HTMLAnchorElement;

  const idKavlingInput = document.getElementById('idKavling') as HTMLInputElement;
  const proyekSelect = document.getElementById('proyek') as HTMLSelectElement;
  const namaLengkapInput = document.getElementById('namaLengkap') as HTMLInputElement;
  const nomorWhatsAppInput = document.getElementById('nomorWhatsApp') as HTMLInputElement;
  const keluhanInput = document.getElementById('keluhan') as HTMLTextAreaElement;

  const errorEls: Record<string, HTMLElement | null> = {
    idKavling: document.getElementById('error-idKavling'),
    proyek: document.getElementById('error-proyek'),
    namaLengkap: document.getElementById('error-namaLengkap'),
    nomorWhatsApp: document.getElementById('error-nomorWhatsApp'),
    keluhan: document.getElementById('error-keluhan'),
  };

  const inputs: Record<string, HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement> = {
    idKavling: idKavlingInput,
    proyek: proyekSelect,
    namaLengkap: namaLengkapInput,
    nomorWhatsApp: nomorWhatsAppInput,
    keluhan: keluhanInput,
  };

  function showError(element: HTMLElement | null, message: string) {
    if (element) {
      element.textContent = message;
      element.classList.remove('hidden');
    }
  }

  function hideError(element: HTMLElement | null) {
    if (element) {
      element.textContent = '';
      element.classList.add('hidden');
    }
  }

  function setFieldState(field: string, message: string | null) {
    const input = inputs[field];
    const errorEl = errorEls[field];
    if (message) {
      showError(errorEl, message);
      input.classList.add('border-red-500');
      input.setAttribute('aria-invalid', 'true');
    } else {
      hideError(errorEl);
      input.classList.remove('border-red-500');
      input.removeAttribute('aria-invalid');
    }
    return !message;
  }

  const validators: Record<string, (value: string) => string | null> = {
    idKavling: (value) => (value.trim() ? null : 'ID Kavling wajib diisi'),
    proyek: (value) => (value ? null : 'Silakan pilih proyek perumahan'),
    namaLengkap: (value) => validateName(value),
    nomorWhatsApp: (value) => validateWhatsApp(value),
    keluhan: (value) => {
      const trimmed = value.trim();
      if (!trimmed) return 'Detail keluhan wajib diisi';
      if (trimmed.length < 10) return 'Jelaskan keluhan minimal 10 karakter agar kami memahami permasalahan Anda';
      return null;
    },
  };

  function validateField(field: string): boolean {
    return setFieldState(field, validators[field](inputs[field].value));
  }

  function validateForm(): boolean {
    const fields = Object.keys(validators);
    let firstInvalid: HTMLElement | null = null;
    fields.forEach((field) => {
      const ok = validateField(field);
      if (!ok && !firstInvalid) firstInvalid = inputs[field];
    });
    firstInvalid?.focus();
    return !firstInvalid;
  }

  function generateReferenceNumber(): string {
    const now = new Date();
    const dateStamp = `${now.getFullYear()}${String(now.getMonth() + 1).padStart(2, '0')}${String(now.getDate()).padStart(2, '0')}`;
    const random = Math.floor(1000 + Math.random() * 9000);
    return `RPT-${dateStamp}-${random}`;
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    successMessage?.classList.add('hidden');

    if (!validateForm()) {
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Menyiapkan Laporan...';

    // TODO: saat REST API siap, kirim formData ke server dan pakai nomor tiket dari respons.
    const reference = generateReferenceNumber();
    const formData = {
      idKavling: idKavlingInput.value.trim(),
      proyek: proyekSelect.selectedOptions[0]?.textContent || proyekSelect.value,
      namaLengkap: namaLengkapInput.value.trim(),
      nomorWhatsApp: nomorWhatsAppInput.value.trim(),
      keluhan: keluhanInput.value.trim(),
    };

    const message = `Halo Bumi Group, saya ingin melaporkan keluhan perumahan.\n\nNo. Referensi: ${reference}\nID Kavling: ${formData.idKavling}\nProyek: ${formData.proyek}\nNama: ${formData.namaLengkap}\nNo. HP: ${formData.nomorWhatsApp}\n\nDetail Keluhan:\n${formData.keluhan}`;
    const waUrl = whatsappLink(message);

    if (ticketNumber) ticketNumber.textContent = reference;
    if (reportWaLink) reportWaLink.href = waUrl;
    successMessage?.classList.remove('hidden');

    window.open(waUrl, '_blank', 'noopener');

    form.reset();
    Object.keys(inputs).forEach((field) => {
      inputs[field].classList.remove('border-red-500');
      inputs[field].removeAttribute('aria-invalid');
    });

    submitBtn.disabled = false;
    submitBtn.textContent = 'Kirim Laporan';
  });

  (['idKavling', 'namaLengkap', 'nomorWhatsApp', 'keluhan'] as const).forEach((field) => {
    inputs[field]?.addEventListener('blur', () => validateField(field));
  });

  proyekSelect?.addEventListener('change', () => validateField('proyek'));
</script>

<style>
  /* Animasi muncul saat panel referensi ditampilkan; mati untuk pengguna reduced-motion */
  @keyframes ticket-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .report-success-pop {
    animation: ticket-in 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .report-success-pop {
      animation: none;
    }
  }
</style>
