---
import { Icon } from 'astro-icon/components';
import { whatsappLink } from '../utils/config';
import { companyProfile } from '../data/bumiGroup';
---

<div class="fixed bottom-5 right-5 z-40 no-print">
  <a
    href={whatsappLink('Halo Admin Bumi Group Pamekasan, saya tertarik dengan info perumahan & jadwal survey.', companyProfile.mainAdminPhone)}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2.5 bg-brand-700 hover:bg-brand-800 text-white px-5 py-3.5 rounded-full shadow-lg active:scale-[0.98] transition-all duration-200 border border-brand-600 min-h-12"
    aria-label="Konsultasi WhatsApp Admin Bumi Group"
    id="sticky-whatsapp"
  >
    <Icon name="ph:whatsapp-logo-fill" class="w-5 h-5 shrink-0" aria-hidden="true" />
    <span class="text-xs sm:text-sm font-bold whitespace-nowrap">Konsultasi WA</span>
  </a>
</div>

<script>
  const sticky = document.getElementById('sticky-whatsapp');
  const primaryCtas = document.querySelectorAll('#kpr-wa-btn, #submit-btn');

  if (sticky && primaryCtas.length > 0) {
    const visibleCtas = new Set<Element>();

    const sync = () => {
      const hidden = visibleCtas.size > 0 || document.body.style.overflow === 'hidden';
      sticky.style.transform = hidden ? 'translateY(140%)' : '';
      sticky.style.opacity = hidden ? '0' : '';
      sticky.style.pointerEvents = hidden ? 'none' : '';
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) visibleCtas.add(entry.target);
        else visibleCtas.delete(entry.target);
      });
      sync();
    });

    primaryCtas.forEach((cta) => observer.observe(cta));

    new MutationObserver(sync).observe(document.body, {
      attributes: true,
      attributeFilter: ['style'],
    });
  }
</script>
