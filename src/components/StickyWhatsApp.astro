---
import { whatsappLink } from '../utils/config';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
---

<div class="fixed bottom-6 right-6 z-40 no-print">
  <a
    href={whatsappLink('Halo Sales Bumi Group, saya tertarik dengan unit perumahan. Boleh minta info katalog & jadwal survey?')}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-3 bg-[#25D366] hover:bg-[#20bd5a] text-white px-5 py-3.5 rounded-full shadow-[0_10px_25px_-5px_rgba(37,211,102,0.6)] hover:shadow-[0_15px_30px_-5px_rgba(37,211,102,0.8)] active:scale-[0.98] transition-all duration-300 group border-2 border-white"
    aria-label="Chat WhatsApp Sales Bumi Group"
    id="sticky-whatsapp"
  >
    <!-- Icon with Online Dot -->
    <div class="relative flex items-center justify-center">
      <WhatsAppIcon class="w-7 h-7 fill-current" />
      <span class="absolute -top-1 -right-1 w-3.5 h-3.5 bg-yellow-300 border-2 border-white rounded-full animate-ping" aria-hidden="true"></span>
      <span class="absolute -top-1 -right-1 w-3.5 h-3.5 bg-yellow-300 border-2 border-white rounded-full" aria-hidden="true"></span>
    </div>

    <!-- Text Label for High Visibility -->
    <div class="flex flex-col text-left pr-1">
      <span class="text-xs font-black uppercase tracking-wider text-white leading-tight">Konsultasi WA</span>
      <span class="text-[11px] font-bold text-white/90 leading-tight">Sales Respon Cepat</span>
    </div>
  </a>
</div>

<script>
  // Sembunyikan tombol melayang saat CTA WhatsApp utama lain sedang terlihat
  // (mis. tombol konsultasi KPR) agar tidak menutupi ajakan aksi tersebut.
  const sticky = document.getElementById('sticky-whatsapp');
  const primaryCtas = document.querySelectorAll('#kpr-wa-btn');

  if (sticky && primaryCtas.length > 0) {
    const visibleCtas = new Set<Element>();

    const sync = () => {
      const hidden = visibleCtas.size > 0 || document.body.style.overflow === 'hidden';
      sticky.style.transform = hidden ? 'translateY(140%)' : '';
      sticky.style.opacity = hidden ? '0' : '';
      sticky.style.pointerEvents = hidden ? 'none' : '';
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) visibleCtas.add(entry.target);
        else visibleCtas.delete(entry.target);
      });
      sync();
    });

    primaryCtas.forEach((cta) => observer.observe(cta));

    // Sembunyikan juga saat dialog/menu terbuka (body di-scroll-lock oleh dialog helper)
    new MutationObserver(sync).observe(document.body, {
      attributes: true,
      attributeFilter: ['style'],
    });
  }
</script>
