const unitTypes = [
  {
    id: 'tipe-50',
    tabLabel: 'Tipe 50',
    title: 'Rumah Tipe 50 Modern Minimalis',
    locationTag: 'Bumi Tlanakan Residence & Klaster',
    adminPhone: '0823-3044-3131',
    image: tipe50Img,
    description:
      'Konsep hunian modern minimalis dengan fasad bersih, carport lega, dan tata ruang fungsional untuk keluarga muda maupun hunian jangka panjang.',
    highlights: [
      'Fasad modern minimalis dengan aksen kayu hangat',
      'Ruang keluarga lapang dan sirkulasi udara optimal',
      'Carport lega dan area taman depan tertata',
      'Berlokasi di jalur strategis Kecamatan Tlanakan',
    ],
    specs: {
      foundation: 'Batu Kali & Beton Bertulang',
      wall: 'Bata / Hebel Diplester, Aci, & Cat Weatherproof',
      roof: 'Rangka Baja Ringan & Penutup Atap Minimalis',
      sanitary: 'Kloset Duduk & Shower Standar SNI',
      electricity: 'Instalasi Listrik Standar PLN (1.300 - 2.200 Watt)',
      water: 'Sumber Air Bersih Siap Pakai',
    },
  },
  {
    id: 'klaster-kompak',
    tabLabel: 'Tipe 36',
    title: 'Unit Klaster Kompak Minimalis',
    locationTag: 'Kangenan, Bugih & Pademawu',
    adminPhone: '0823-3642-4142',
    image: tipe36Img,
    description:
      'Pilihan hunian efisien dan mudah dirawat bagi pasangan muda atau keluarga kecil yang mengutamakan kenyamanan lingkungan klaster.',
    highlights: [
      '2 Kamar Tidur dan 1 Kamar Mandi fungsional',
      'Tata letak ruang tamu menyatu dengan ruang makan',
      'Taman depan asri dan carport kendaraan pribadi',
      'Lingkungan klaster tenang dan mudah diakses',
    ],
    specs: {
      foundation: 'Batu Kali & Sloof Beton Bertulang',
      wall: 'Bata / Hebel Diplester & Dicat Rapi',
      roof: 'Rangka Baja Ringan & Genteng Standar Cluster',
      sanitary: 'Kloset Duduk & Keran Air Bersih',
      electricity: '1.300 Watt Standar Residensial',
      water: 'Sumber Air Bersih Terintegrasi',
    },
  },
  {
    id: 'klaster-keluarga',
    tabLabel: 'Tipe 45',
    title: 'Unit Klaster Keluarga Berkembang',
    locationTag: 'Area Kangenan & Pademawu',
    adminPhone: '0813-3370-7033',
    image: tipe45Img,
    description:
      'Memberikan ruang gerak lebih lega untuk aktivitas keluarga sehari-hari dengan pencahayaan alami dan proporsi fasad yang seimbang.',
    highlights: [
      'Ruang keluarga luas dan area dapur terpisah rapi',
      'Bukaan jendela lebar untuk cahaya alami maksimal',
      'Area belakang fleksibel untuk pengembangan ruang',
      'Akses jalan lingkungan nyaman untuk kendaraan',
    ],
    specs: {
      foundation: 'Beton Bertulang Standar Konstruksi Klaster',
      wall: 'Pasangan Bata / Hebel Finis Cat Eksterior-Interior',
      roof: 'Rangka Baja Ringan & Penutup Atap Kokoh',
      sanitary: 'Sanitari Lengkap & Instalasi Air Bersih',
      electricity: '1.300 - 2.200 Watt',
      water: 'Sumber Air Bersih Siap Huni',
    },
  },
  {
    id: 'residensial-2-lantai',
    tabLabel: 'Tipe 60',
    title: 'Unit Residensial Luas & Komersial',
    locationTag: 'Unit Pilihan Portofolio Bumi Group',
    adminPhone: '0823-3044-3131',
    image: tipe60Img,
    description:
      'Opsi hunian berukuran lebih luas untuk keluarga besar atau kebutuhan investasi properti jangka panjang di kawasan berkembang Pamekasan.',
