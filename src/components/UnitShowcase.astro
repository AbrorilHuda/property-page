---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { whatsappLink } from '../utils/config';
import tipe50Img from '../assets/images/cluster_tlanakan_50.jpg';
import tipe36Img from '../assets/images/tipe_36.png';
