---
const values = [
  {
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
    title: 'Lokasi Strategis',
    description: 'Akses mudah ke pusat kota, sekolah, dan fasilitas umum.',
  },
  {
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    title: 'Legalitas Aman',
    description: 'SHM & IMB terjamin, proses jual-beli transparan.',
  },
  {
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>`,
    title: 'Lingkungan Asri',
    description: 'Konsep hunian hijau untuk kenyamanan keluarga Anda.',
  },
  {
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    title: 'Harga Terjangkau',
    description: 'Skema KPR mudah, subsidi & komersil.',
  },
];
---

<section id="value-prop" class="py-16 md:py-20 bg-white">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6">
    <div class="text-center mb-12">
      <h2 class="text-bumi-navy-dark text-2xl sm:text-3xl md:text-4xl font-bold mb-4">
        Lebih dari Sekadar Rumah
      </h2>
      <p class="text-bumi-navy-light text-lg sm:text-xl">
        Ini Investasi Masa Depan
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {values.map((item) => (
        <div class="group bg-bumi-off-white rounded-2xl p-6 md:p-8 text-center hover:shadow-lg transition-all duration-200 hover:-translate-y-1">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-bumi-green-light/15 rounded-xl text-bumi-green-dark mb-5 group-hover:bg-bumi-green-dark group-hover:text-white transition-colors duration-200">
            <Fragment set:html={item.icon} />
          </div>
          <h3 class="text-bumi-navy-dark text-lg font-bold mb-2">{item.title}</h3>
          <p class="text-bumi-navy-light text-sm leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
