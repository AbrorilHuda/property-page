---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ReportForm from '../components/ReportForm.astro';
import Footer from '../components/Footer.astro';
import StickyWhatsApp from '../components/StickyWhatsApp.astro';
import { Icon } from 'astro-icon/components';
import { config, whatsappLink } from '../utils/config';
import { companyProfile } from '../data/bumiGroup';

const steps = [
  {
    title: 'Isi Formulir',
    desc: 'Lengkapi ID kavling, pilih klaster Bumi Group, dan tuliskan detail keluhan.',
  },
  {
    title: 'Verifikasi Tim',
    desc: 'Admin area terkait memverifikasi laporan dan menjadwalkan pengecekan lapangan.',
  },
  {
    title: 'Tindak Lanjut',
    desc: 'Penanganan dikerjakan dan perkembangannya dikabarkan hingga tuntas.',
  },
];
---

<Layout
  title="Lapor Keluhan | Bumi Group Pamekasan"
  description="Pemilik kavling Bumi Group (PT Bumi Griya Madani) di Pamekasan dapat menyampaikan keluhan perumahan melalui formulir resmi ini."
>
  <Navbar />
  <main id="main-content" class="bg-canvas-light dark:bg-canvas-dark">
    <!-- Page Header (Unified Theme Lock) -->
    <section class="pt-28 pb-12 md:pt-32 md:pb-16 border-b border-[#DCE3D6] dark:border-slate-800 bg-canvas-muted dark:bg-surface-dark">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="max-w-2xl space-y-4">
          <p class="reveal active text-xs font-bold uppercase tracking-[0.16em] text-brand-700 dark:text-brand-400">
            Layanan Pemilik Hunian
          </p>
          <h1 class="reveal active reveal-delay-1 text-[#111D2E] dark:text-white text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-[1.1]">
            Laporkan Keluhan,
            <span class="text-brand-700 dark:text-brand-400">Kami Tindak Lanjuti</span>
          </h1>
          <p class="reveal active reveal-delay-2 text-slate-600 dark:text-slate-300 text-base sm:text-lg font-medium leading-relaxed">
            Sampaikan keluhan unit atau lingkungan klaster lewat formulir resmi ini. Laporan dikirim ke admin area proyek Anda beserta nomor referensi pelacakan.
          </p>
        </div>
      </div>
    </section>

    <!-- Form + Rail -->
    <section class="py-14 md:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 grid lg:grid-cols-12 gap-10 lg:gap-14 items-start">

        <div class="lg:col-span-7 reveal">
          <ReportForm />
          <p class="flex items-start gap-2 text-slate-600 dark:text-slate-400 text-xs font-semibold mt-4 px-1">
            <Icon name="ph:shield-check-bold" class="w-4 h-4 shrink-0 mt-0.5 text-brand-700 dark:text-brand-400" aria-hidden="true" />
            <span>Data yang Anda kirimkan hanya digunakan untuk tindak lanjut laporan ini.</span>
          </p>
        </div>

        <aside class="lg:col-span-5 space-y-8">
          <div class="reveal bg-white dark:bg-surface-dark rounded-2xl p-6 sm:p-7 border border-[#DCE3D6] dark:border-slate-800 shadow-card space-y-2">
            <p class="text-[#111D2E] dark:text-white text-4xl sm:text-5xl font-extrabold tracking-tight">
              1<span class="text-brand-700 dark:text-brand-400">&times;</span>24
              <span class="text-lg sm:text-xl font-bold text-slate-500 dark:text-slate-400">jam kerja</span>
            </p>
            <p class="text-slate-600 dark:text-slate-300 text-sm font-medium leading-relaxed">
              Target respons awal tim kami untuk setiap laporan pemilik kavling yang masuk pada hari kerja.
            </p>
          </div>

          <div class="reveal reveal-delay-1 bg-white dark:bg-surface-dark rounded-2xl p-6 sm:p-7 border border-[#DCE3D6] dark:border-slate-800 shadow-card">
            <h2 class="text-[#111D2E] dark:text-white font-extrabold text-lg mb-5">Alur Penanganan Laporan</h2>
            <ol class="relative ml-2 space-y-5 border-l-2 border-[#DCE3D6] dark:border-slate-700">
              {steps.map((step) => (
                <li class="relative pl-6">
                  <span class="absolute -left-[9px] top-1 w-4 h-4 rounded-md bg-brand-700 ring-4 ring-white dark:ring-surface-dark" aria-hidden="true"></span>
                  <h3 class="text-[#111D2E] dark:text-white font-bold text-sm">{step.title}</h3>
                  <p class="text-slate-600 dark:text-slate-300 text-sm font-medium mt-0.5 leading-relaxed">{step.desc}</p>
                </li>
              ))}
            </ol>
          </div>

          <div class="reveal reveal-delay-2 bg-white dark:bg-surface-dark rounded-2xl p-6 sm:p-7 border border-[#DCE3D6] dark:border-slate-800 shadow-card space-y-4">
            <h2 class="text-[#111D2E] dark:text-white font-extrabold text-lg">Kontak Layanan Resmi</h2>
            <ul class="space-y-3 text-sm font-semibold">
              <li class="flex items-center gap-3">
                <Icon name="ph:whatsapp-logo-fill" class="w-5 h-5 shrink-0 text-brand-700 dark:text-brand-400" aria-hidden="true" />
                <a
                  href={whatsappLink('Halo Admin Bumi Group Pamekasan, saya ingin melaporkan keluhan perumahan.', companyProfile.mainAdminPhone)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-slate-700 dark:text-slate-200 hover:text-brand-700 dark:hover:text-brand-400 transition-colors"
                >
                  {companyProfile.mainAdminPhone} (Kantor Pusat)
                </a>
              </li>
              <li class="flex items-center gap-3">
                <Icon name="ph:envelope-simple-bold" class="w-5 h-5 shrink-0 text-brand-700 dark:text-brand-400" aria-hidden="true" />
                <a href={`mailto:${config.adminEmail}`} class="text-slate-700 dark:text-slate-200 hover:text-brand-700 dark:hover:text-brand-400 transition-colors">
                  {config.adminEmail}
                </a>
              </li>
              <li class="flex items-start gap-3">
                <Icon name="ph:clock-bold" class="w-5 h-5 shrink-0 mt-0.5 text-brand-700 dark:text-brand-400" aria-hidden="true" />
                <span class="text-slate-700 dark:text-slate-200">{companyProfile.mainHours}</span>
              </li>
            </ul>
          </div>
        </aside>

      </div>
    </section>
  </main>
  <Footer />
  <StickyWhatsApp />
</Layout>
