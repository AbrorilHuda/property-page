---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ReportForm from '../components/ReportForm.astro';
import Footer from '../components/Footer.astro';
import StickyWhatsApp from '../components/StickyWhatsApp.astro';
import WhatsAppIcon from '../components/icons/WhatsAppIcon.astro';
import { Image } from 'astro:assets';
import { config, whatsappLink } from '../utils/config';
import heroHouse from '../assets/images/hero_house.png';
import facilityGate from '../assets/images/facility_gate.png';

const steps = [
  {
    title: 'Isi Formulir',
    desc: 'Lengkapi data kavling dan jelaskan keluhan Anda.',
  },
  {
    title: 'Verifikasi Tim',
    desc: 'Customer service memverifikasi dan menjadwalkan pengecekan.',
  },
  {
    title: 'Tindak Lanjut',
    desc: 'Perbaikan dikerjakan, progres dikabarkan hingga selesai.',
  },
];
---

<Layout
  title="Lapor Keluhan | Bumi Group"
  description="Pemilik kavling Bumi Group dapat menyampaikan keluhan perumahan melalui formulir ini. Tim kami menindaklanjuti setiap laporan maksimal 1×24 jam kerja."
>
  <Navbar />
  <main id="main-content">
    <!-- Page Header: split band, headline kiri, foto kanan -->
    <section class="relative bg-slate-950 text-white overflow-hidden">
      <div class="absolute inset-0 z-0" aria-hidden="true">
        <Image
          src={heroHouse}
          alt=""
          widths={[768, 1280, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="w-full h-full object-cover object-[68%_center] brightness-[0.4]"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/85 to-slate-950/30"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-slate-950/60"></div>
      </div>

      <div class="relative z-10 max-w-[1280px] mx-auto px-4 sm:px-6 pt-32 pb-20 md:pt-40 md:pb-24">
        <div class="max-w-2xl space-y-5">
          <p class="reveal text-xs font-bold uppercase tracking-wider text-brand-400">
            Layanan Pemilik Hunian
          </p>
          <h1 class="reveal reveal-delay-1 text-white text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-[1.12]">
            Laporkan Keluhan,
            <span class="text-brand-400">Kami yang Tindak Lanjuti</span>
          </h1>
          <p class="reveal reveal-delay-2 text-slate-300 text-base sm:text-lg font-medium leading-relaxed">
            Sampaikan keluhan perumahan lewat formulir resmi ini. Laporan Anda diteruskan ke tim
            customer service dengan nomor referensi dan ditindaklanjuti maksimal 1&times;24 jam kerja.
          </p>
        </div>
      </div>
    </section>

    <!-- Form + Rail -->
    <section class="bg-slate-50 pb-20 md:pb-28">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 grid lg:grid-cols-5 gap-10 lg:gap-16 items-start">

        <!-- Form, overlap ke band gelap -->
        <div class="lg:col-span-3 relative z-20 -mt-10 md:-mt-14 reveal reveal-delay-1">
          <ReportForm />
          <p class="flex items-start gap-2.5 text-slate-600 text-xs font-semibold mt-4 px-1">
            <svg class="w-4 h-4 shrink-0 mt-px text-brand-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016" />
            </svg>
            Data Anda hanya digunakan untuk tindak lanjut laporan ini.
          </p>
        </div>

        <!-- Rail informasi -->
        <aside class="lg:col-span-2 space-y-10 pt-2 lg:pt-16">
          <div class="reveal">
            <p class="text-slate-900 text-5xl sm:text-6xl font-extrabold tracking-tight">
              1<span class="text-brand-700">&times;</span>24
              <span class="text-xl sm:text-2xl font-bold text-slate-500">jam kerja</span>
            </p>
            <p class="text-slate-600 text-sm font-semibold mt-2 max-w-xs leading-relaxed">
              Batas waktu respons pertama kami untuk setiap laporan yang masuk.
            </p>
          </div>

          <div class="reveal reveal-delay-1">
            <h2 class="text-slate-900 font-extrabold text-lg mb-5">Alur laporan Anda</h2>
            <ol class="relative ml-2 space-y-6 border-l-2 border-slate-200">
              {steps.map((step) => (
                <li class="relative pl-6">
                  <span class="absolute -left-[9px] top-1 w-4 h-4 rounded-[5px] bg-brand-700 ring-4 ring-slate-50" aria-hidden="true"></span>
                  <h3 class="text-slate-900 font-bold text-sm">{step.title}</h3>
                  <p class="text-slate-600 text-sm font-medium mt-0.5 leading-relaxed">{step.desc}</p>
                </li>
              ))}
            </ol>
          </div>

          <div class="reveal reveal-delay-2">
            <h2 class="text-slate-900 font-extrabold text-lg mb-4">Butuh bantuan langsung?</h2>
            <ul class="space-y-3.5 text-sm font-semibold">
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 shrink-0 text-brand-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <a href={`tel:${config.businessPhone}`} class="text-slate-700 hover:text-brand-800 transition-colors">{config.businessPhone}</a>
              </li>
              <li class="flex items-center gap-3">
                <WhatsAppIcon class="w-5 h-5 shrink-0 text-brand-700" />
                <a href={whatsappLink('Halo Bumi Group, saya ingin melaporkan keluhan perumahan.')} target="_blank" rel="noopener noreferrer" class="text-slate-700 hover:text-brand-800 transition-colors">{config.whatsappNumber}</a>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 shrink-0 text-brand-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-slate-700">Senin - Sabtu, {config.businessHours} WIB</span>
              </li>
            </ul>
          </div>
        </aside>

      </div>
    </section>
  </main>
  <Footer />
  <StickyWhatsApp />
</Layout>
