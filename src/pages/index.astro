---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProjectsDirectory from '../components/ProjectsDirectory.astro';
import ConceptAndAbout from '../components/ConceptAndAbout.astro';
import UnitShowcase from '../components/UnitShowcase.astro';
import ClusterFeatures from '../components/ClusterFeatures.astro';
import GalleryShowcase from '../components/GalleryShowcase.astro';
import KPRCalculator from '../components/KPRCalculator.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactAndSurvey from '../components/ContactAndSurvey.astro';
import Footer from '../components/Footer.astro';
import StickyWhatsApp from '../components/StickyWhatsApp.astro';
---

<Layout title="Bumi Group - Hunian Modern Minimalis di Pamekasan | PT Bumi Griya Madani">
  <Navbar />
  <main id="main-content">
    <Hero />
    <ProjectsDirectory />
    <ConceptAndAbout />
    <UnitShowcase />
    <ClusterFeatures />
    <GalleryShowcase />
    <KPRCalculator />
    <Testimonials />
    <ContactAndSurvey />
  </main>
  <Footer />
  <StickyWhatsApp />
</Layout>
